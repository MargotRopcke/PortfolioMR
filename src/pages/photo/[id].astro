---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const photoCollections = await getCollection("photo");
    return photoCollections.map((photo) => ({
        params: { id: photo.id },
        props: { photo },
    }));
}

const { photo } = Astro.props;
const { Content } = await render(photo);
---

<Detail>
    <section class="photo">
                <div class="photo__card">
        <h1 class="photo__title">{photo.data.title}</h1>
        <div class="photo__image">      
       <Image
       transition:animate="slide"
  src={photo.data.image}
  alt={photo.data.title}
  class="photo__images"
/>

                </div>
        <div class="photo__content">
            <Content />
        </div>
            <a href="/portfolio/samples" class="back-button">← Go Back</a>   
           </div>
    </section>
</Detail>

<style>
.photo {
    background: var(--color-black);
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 4rem) 4rem;
}

.photo__card {
    display: grid;
    gap: 1.5rem;
    margin: 0 auto;
    max-width: 50rem;
    width: 100%;
}

.photo__title {
    color: var(--main-color);
    font: 300 clamp(2.8rem, 7vw, 6rem)/0.9 var(--font-display);
    letter-spacing: -0.08em;
    margin: 0;
    text-transform: uppercase;
}

.photo__image {
    border: 1px solid var(--color-divider);
    overflow: hidden;
}

.photo__images {
    display: block;
    height: auto;
    width: 100%;
    object-fit: cover;
}

.photo__content {
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.7;
}

.back-button {
    border: 1px solid var(--color-divider);
    color: var(--main-color);
    display: inline-flex;
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.12em;
    padding: 0.9rem 1.2rem;
    text-transform: uppercase;
    width: fit-content;
}

.back-button:hover {
    border-color: var(--main-color);
}

</style>