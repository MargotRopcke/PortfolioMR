---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const photoCollections = await getCollection("photo");
    return photoCollections.map((photo) => ({
        params: { id: photo.id },
        props: { photo },
    }));
}

const { photo } = Astro.props;
const { Content } = await render(photo);
---

<Detail>
    <section class="photo">
                <div class="photo__card">
        <h1 class="photo__title">{photo.data.title}</h1>
        <div class="photo__image">      
            <Image
        src={photo.data.image}
        alt="workpic"
        width="200"
        class="photo__images"
      />
                </div>
                <a href="/portfolio/samples" class="back-button">← Go Back</a>   
        <div class="photo__content">
            <Content />
        </div>
           </div>
    </section>
</Detail>

<style>

    .photo {
    display: flex;
    justify-content: center;  
    padding: 2rem;
}

.photo__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 650px;         
    width: 100%;
    padding: 2rem;
    background: var(--color-black);    
    border-radius: 1rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    gap: 0.2rem;         
}

.photo__content {
     color: var(--main-color);
}


     .back-button {
        font-family: var(--font-secondary);
        display: inline-block;
        padding: 0.5rem 1rem;
              margin-top: var(--sp-2xs);
        margin-bottom: var(--sp-2xs);

        background-color: var(--color-blue);
        color: var(--color-black);
        text-decoration: none;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        background-color: var(--color-red);
        transform: translateX(-4px);
                color: var(--main-color);
    }
</style>