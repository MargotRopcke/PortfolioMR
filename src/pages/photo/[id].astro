---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const photoCollections = await getCollection("photo");
    return photoCollections.map((photo) => ({
        params: { id: photo.id },
        props: { photo },
    }));
}

const { photo } = Astro.props;
const { Content } = await render(photo);
---

<Detail>
    <section class="photo">
                <div class="photo__card">
        <h1 class="photo__title">{photo.data.title}</h1>
        <div class="photo__image">      
       <Image
  src={photo.data.image}
  alt={photo.data.title}
  class="photo__images"
/>

                </div>
        <div class="photo__content">
            <Content />
        </div>
            <a href="/portfolio/samples" class="back-button">← Go Back</a>   
           </div>
    </section>
</Detail>

<style>
.photo {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 2rem;
}

.photo__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 28.125rem;
    width: 100%;
    padding: 1.5rem;
    background: var(--color-black);
    border-radius: 1rem;
    box-shadow: 0 0.25rem 0.875rem rgba(0, 0, 0, 0.1);
    gap: 1rem;
}

.photo__image {
    width: 100%;
    max-width: 25rem;
    margin: 0 auto;
}

.photo__images {
    width: 100%;
    height: auto;
    border-radius: 0.8rem;
    object-fit: cover;
}

.photo__content {
    color: var(--main-color);
}

.back-button {
    font-family: var(--font-secondary);
    display: inline-block;
    padding: 0.5rem 1rem;
    margin-top: 1rem;
    background-color: var(--color-blue);
    color: var(--color-black);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
}

.back-button:hover {
    background-color: var(--color-red);
    transform: translateX(-0.25rem);
    color: var(--main-color);
}

</style>