---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

import { getEntry } from "astro:content";
import comp from "../assets/comp.png";
import lightbulb from "../assets/lightbulb.png";
import palette from "../assets/palette.png";

const skills = await getEntry("about", "skills");
---

<Base title="Home Page">
    <section class="intro">
        <h1 class="intro__title">Who am I?</h1>
        <p class="intro__text">
            I’m passionate about turning ideas into intuitive, visually
            compelling digital experiences that people actually enjoy using.<br> I’m
            a fast learner, a reliable teammate, and a professional who gets
            things done — all while keeping a dash of wit and creativity in my
            work. <br>Whether it’s crafting clean, user-friendly interfaces or
            diving into code to bring designs to life, I tackle challenges with
            curiosity and precision.<br> When I’m not designing or programming, you
            might catch me trying out new trends, experimenting with my own
            creative projects, or finding inspiration in the world around me.
        </p>
    </section>

    <section class="skills">
        <h2 class="skills__one">Development Skills</h2>
        <div class="skills__development">
        <ul class="skills__text-one">
            {skills.data.development.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
        <img
        src={comp.src}
        alt="Picture of Computer"
        width="200"
        class="comp skill-image"
      />
    </div>

        <h2 class="skills__two">Visual Design Skills</h2>
          <div class="skills__design">
        <ul class="skills__text-two">
            {skills.data.visual.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
          <img
        src={palette.src}
        alt="Picture of Palette"
        width="200"
        class="palette skill-image"
      />
            </div>

        <h2 class="skills__three">UX/UI Skills</h2>
         <div class="skills__ux">
        <ul class="skills__text-three">
            {skills.data.ux.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
          <img
        src={lightbulb.src}
        alt="Picture of Lightbulb"
        width="200"
        class="lightbulb skill-image"
      />
        </div>
    </section>
</Base>

<style>
    .intro {
        background: var(--color-black);
        border-top: 1px solid var(--color-divider);
        border-bottom: 1px solid var(--color-divider);
        padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    }

    .intro__title {
        color: var(--main-color);
        font: 300 clamp(3rem, 8vw, 7rem)/0.9 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .intro__text {
        color: var(--color-muted);
        font: 400 clamp(0.95rem, 1.5vw, 1.3rem)/1.6 var(--font-display);
        margin: 0;
        max-width: 60rem;
    }

    .skills {
        background: var(--color-black);
        padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 5vw, 4rem) 4rem;
    }

    .skills__one,
    .skills__two,
    .skills__three {
        color: var(--main-color);
        font: 300 clamp(2.2rem, 5vw, 4.5rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .skills__development,
    .skills__design,
    .skills__ux {
        align-items: center;
        border-top: 1px solid var(--color-divider);
        display: flex;
        gap: 1.5rem;
        justify-content: space-between;
        padding: 1.5rem 0;
        flex-wrap: wrap;
    }

    .skills__text-one,
    .skills__text-two,
    .skills__text-three {
        color: var(--color-muted);
        flex: 2 1 16rem;
        font: 400 clamp(1rem, 1.2vw, 1.3rem)/1.6 var(--font-display);
        list-style: disc;
        margin: 0;
        padding-left: 1.5rem;
    }

    .skills__text-one li,
    .skills__text-two li,
    .skills__text-three li {
        margin-bottom: 0.35rem;
    }

    .skill-image {
        filter: grayscale(1);
        height: auto;
        max-width: 11rem;
        object-fit: contain;
        width: 100%;
    }

    @media (max-width: 46rem) {
        .skills__development,
        .skills__design,
        .skills__ux {
            align-items: flex-start;
        }

        .skill-image {
            max-width: 7rem;
        }
    }
</style>
