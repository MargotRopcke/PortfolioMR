---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

import { getEntry } from "astro:content";
import margot from "../assets/margot.jpg";

const skills = await getEntry("about", "skills");
const skillGroups = {
    development: skills?.data?.development ?? [],
    visual: skills?.data?.visual ?? [],
    ux: skills?.data?.ux ?? [],
};
const tools = [
    "Figma",
    "Miro",
    "Illustrator",
    "Photoshop",
    "After Effects",
    "VS Code",
    "Github",
    "Astro",
    "HTML",
    "CSS",
    "JavaScript",
];
---

<Base title="Home Page">
    <section class="intro">
        <div class="section-label intro__label">
            <span>01</span><span>About me</span>
        </div>
        <div class="intro__grid">
            <div class="intro__copy">
                <h1 class="intro__title">Who am I?</h1>
                <p class="intro__text">
                    Hi, I’m Margot.<br /><br />
                    I’m a Digital Design &amp; Development student who loves creating
                    digital experiences that are both useful and beautiful. I move
                    between UX/UI, visual design and code, and I like how each one
                    strengthens the others.<br /><br />
                    UX/UI is where I feel most at home. I’m fascinated by how
                    people interact with digital products, and I enjoy making them
                    more intuitive, accessible and enjoyable to use.<br /><br />
                    I learn best by doing: trying new tools, testing ideas and
                    drawing inspiration from the world around me. I also love
                    exchanging perspectives with others, because better ideas often
                    come from a different point of view.<br /><br />
                    <strong>Always curious. Always learning.</strong>
                </p>
            </div>
            <aside class="intro__panel">
                <div class="intro__portrait-wrap">
                    <img
                        src={margot.src}
                        alt="Portrait of Margot Tropcke"
                        class="intro__portrait"
                    />
                </div>
                <p class="intro__eyebrow">Based in Belgium</p>
                <p class="intro__statement" data-rotating-role>
                    UX/UI Research
                </p>
            </aside>
        </div>
    </section>

    <section class="tools" aria-label="Tools I use">
        <div class="section-label">
            <span>Tools</span>
        </div>
        <div class="tools__list">
            {tools.map((tool) => <span class="tool-badge">{tool}</span>)}
        </div>
    </section>

    <section class="skills">
        <div class="section-label skills__label">
            <span>02</span><span>Skills</span>
        </div>

        <div class="skills__block">
            <h2 class="skills__one">Development</h2>
            <div class="skills__content">
                <p class="skill__description">
                    Turning ideas into clear, functional digital experiences.
                </p>
                <ul class="skills__text-one">
                    {skillGroups.development.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <a href="/portfolioMR/work/?category=Development" class="skill-link">
                        <span>View development work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>

        <div class="skills__block">
            <h2 class="skills__two">Visual design</h2>
            <div class="skills__content">
                <p class="skill__description">
                    Creating expressive visuals with purpose and personality.
                </p>
                <ul class="skills__text-two">
                    {skillGroups.visual.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <a href="/portfolioMR/work/?category=Visual%20Design" class="skill-link">
                        <span>View visual work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>

        <div class="skills__block">
            <h2 class="skills__three">UX / UI</h2>
            <div class="skills__content">
                <p class="skill__description">
                    Making digital products intuitive, accessible and enjoyable.
                </p>
                <ul class="skills__text-three">
                    {skillGroups.ux.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <a href="/portfolioMR/work/?category=UX%20Research" class="skill-link">
                        <span>View UX work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>

        <div class="skills__footer">
            <a href="/portfolioMR/work/" class="skill-link skills__all-link">
                <span>View all work</span><b>↗</b>
            </a>
        </div>
    </section>
</Base>

<script>
    const roles = ["UX/UI Research", "Visual Design", "Motion Design", "Development"];
    const statement = document.querySelector("[data-rotating-role]");
    const transitionDurationMs = 350;

    if (statement instanceof HTMLElement) {
        let roleIndex = 0;

        window.setInterval(() => {
            statement.classList.add("is-fading");

            window.setTimeout(() => {
                roleIndex = (roleIndex + 1) % roles.length;
                statement.textContent = roles[roleIndex];
                statement.classList.remove("is-fading");
            }, transitionDurationMs);
        }, 3000);
    }
</script>

<style>
    .intro {
        background: var(--color-black);
        border-bottom: 1px solid var(--color-divider);
        padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    }

    .intro__label {
        margin-bottom: 2rem;
    }

    .intro__grid {
        align-items: start;
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
    }

    .intro__copy {
        padding-top: clamp(0rem, 2vw, 1.5rem);
    }

    .intro__title {
        color: var(--main-color);
        font: 300 clamp(3rem, 8vw, 7rem)/0.9 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .intro__text {
        color: var(--color-muted);
        font: 400 clamp(0.92rem, 1.25vw, 1.2rem)/1.6 var(--font-display);
        margin: 0;
        max-width: 58rem;
    }

    .intro__panel {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-divider);
        display: grid;
        gap: 0.8rem;
        padding: 0.8rem;
        max-width: 18rem;
        justify-self: end;
        position: relative;
    }

    .intro__panel::before {
        background: var(--color-accent);
        content: "";
        height: 3rem;
        left: -1px;
        position: absolute;
        top: -1px;
        width: 3px;
    }

    .intro__portrait-wrap {
        aspect-ratio: 4 / 5;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-divider);
        overflow: hidden;
        max-height: 22rem;
    }

    .intro__portrait {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .intro__eyebrow {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        margin: 0;
        text-transform: uppercase;
    }

    .intro__statement {
        color: var(--main-color);
        font: 300 clamp(1.2rem, 2vw, 1.8rem)/1.1 var(--font-display);
        letter-spacing: -0.05em;
        margin: 0;
        min-height: 1.2em;
        text-align: center;
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .intro__statement.is-fading {
        opacity: 0;
        transform: translateY(0.25rem);
    }

    @media (prefers-reduced-motion: reduce) {
        .intro__statement {
            transition: none;
        }
    }

    @media (max-width: 700px) {
        .intro__grid {
            grid-template-columns: 1fr;
        }

        .intro__panel {
            max-width: 24rem;
            order: -1;
            width: 100%;
        }
    }

    .tools {
        background: var(--color-black);
        padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    }

    .tools__list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
        padding-top: 0.5rem;
    }

    .tool-badge {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-divider);
        color: var(--main-color);
        display: inline-flex;
        font: 0.62rem var(--font-mono);
        letter-spacing: 0.12em;
        padding: 0.55rem 0.75rem;
        text-transform: uppercase;
    }

    .skills {
        background: var(--color-black);
        padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem) 4rem;
    }

    .skills__label {
        margin-bottom: 1rem;
    }

    .skills__block + .skills__block {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
    }

    .skills__one,
    .skills__two,
    .skills__three {
        color: var(--main-color);
        font: 300 clamp(2rem, 5vw, 4rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .skills__content {
        border-top: 1px solid var(--color-divider);
        display: grid;
        gap: 1.35rem;
        grid-template-columns: minmax(0, 1fr) auto;
        justify-content: space-between;
        padding: 1.2rem 0 0.4rem;
    }

    .skill__description {
        color: var(--color-muted);
        font: 400 clamp(1rem, 1.25vw, 1.2rem)/1.45 var(--font-display);
        grid-column: 1 / -1;
        margin: 0;
        max-width: 32rem;
    }

    .skills__text-one,
    .skills__text-two,
    .skills__text-three {
        color: var(--color-muted);
        flex: 2 1 16rem;
        font: 400 clamp(1rem, 1.2vw, 1.3rem)/1.6 var(--font-display);
        list-style: disc;
        margin: 0;
        padding-left: 1.5rem;
    }

    .skills__text-one::before,
    .skills__text-two::before,
    .skills__text-three::before {
        color: var(--main-color);
        content: "Skills";
        display: block;
        font: 0.62rem var(--font-mono);
        letter-spacing: 0.12em;
        margin: 0 0 0.65rem -1.5rem;
        text-transform: uppercase;
    }

    .skills__text-one li,
    .skills__text-two li,
    .skills__text-three li {
        margin-bottom: 0.35rem;
    }

    .skill__meta {
        display: flex;
        justify-content: flex-end;
        margin-left: auto;
        min-width: 9rem;
    }

    .skill-link {
        align-items: center;
        color: var(--main-color);
        display: inline-flex;
        font: 0.66rem var(--font-mono);
        gap: 0.45rem;
        justify-content: center;
        letter-spacing: 0.12em;
        padding: 0;
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-transform: uppercase;
        transition: opacity 0.2s ease;
    }

    .skill-link b {
        display: inline-flex;
        font-size: 0.9rem;
    }

    .skill-link:hover,
    .skill-link:focus-visible {
        opacity: 0.65;
    }

    .skills__footer {
        display: flex;
        justify-content: center;
        margin-top: 4rem;
        padding-top: 1rem;
    }

    .skills__all-link {
        align-items: center;
        background: var(--color-accent);
        border: 1px solid var(--color-accent);
        color: #ffffff;
        display: inline-flex;
        font: 0.7rem var(--font-mono);
        gap: 0.45rem;
        justify-content: center;
        letter-spacing: 0.12em;
        min-width: 12.5rem;
        padding: 0.7rem 1rem;
        text-decoration: none;
        text-transform: uppercase;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
            transform 0.2s ease;
    }

    .skills__all-link b {
        display: inline-flex;
        font-size: 0.9rem;
    }

    .skills__all-link:hover,
    .skills__all-link:focus-visible {
        background: transparent;
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-1px);
    }

    @media (max-width: 46rem) {
        .intro__grid {
            grid-template-columns: 1fr;
        }

        .intro__panel {
            max-width: 20rem;
        }

        .tools__list {
            gap: 0.5rem;
        }

        .tool-badge {
            font-size: 0.56rem;
            padding: 0.6rem 0.7rem;
        }

        .skills__content {
            align-items: flex-start;
            grid-template-columns: 1fr;
        }

        .skill__meta {
            grid-column: 1;
            justify-content: flex-start;
            min-width: 0;
            width: auto;
        }

        .skill-link {
            width: fit-content;
        }
    }
</style>
