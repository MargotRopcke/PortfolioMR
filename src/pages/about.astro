---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

import { getEntry } from "astro:content";
import comp from "../assets/comp.png";
import lightbulb from "../assets/lightbulb.png";
import margot from "../assets/margot.jpg";
import palette from "../assets/palette.png";

const skills = await getEntry("about", "skills");
const skillGroups = {
    development: skills?.data?.development ?? [],
    visual: skills?.data?.visual ?? [],
    ux: skills?.data?.ux ?? [],
};
const tools = [
    "Figma",
    "Miro",
    "Illustrator",
    "Photoshop",
    "After Effects",
    "VS Code",
    "Github",
    "Astro",
    "HTML",
    "CSS",
    "JavaScript",
];
---

<Base title="Home Page">
    <section class="intro">
        <div class="section-label intro__label">
            <span>01</span><span>About me</span>
        </div>
        <div class="intro__grid">
            <div>
                <h1 class="intro__title">Who am I?</h1>
                <p class="intro__text">
                    Hi, I’m Margot.<br /><br />
                    I’m a Digital Design &amp; Development student who loves creating
                    digital experiences that are both useful and beautiful. I move
                    between UX/UI, visual design and code, and I like how each one
                    strengthens the others.<br /><br />
                    UX/UI is where I feel most at home. I’m fascinated by how
                    people interact with digital products, and I enjoy making them
                    more intuitive, accessible and enjoyable to use.<br /><br />
                    I learn best by doing: trying new tools, testing ideas and
                    drawing inspiration from the world around me. I also love
                    exchanging perspectives with others, because better ideas often
                    come from a different point of view.<br /><br />
                    <strong>Always curious. Always learning.</strong>
                </p>
            </div>
            <aside class="intro__panel">
                <div class="intro__portrait-wrap">
                    <img
                        src={margot.src}
                        alt="Portrait of Margot Tropcke"
                        class="intro__portrait"
                    />
                </div>
                <p class="intro__eyebrow">Based in Belgium</p>
                <p class="intro__statement">
                 UX Researcher, Designer & Developer
                </p>
            </aside>
        </div>
    </section>

    <section class="tools" aria-label="Tools I use">
        <div class="section-label">
            <span>Tools</span><span>That I work with</span>
        </div>
        <div class="tools__list">
            {tools.map((tool) => <span class="tool-badge">{tool}</span>)}
        </div>
    </section>

    <section class="skills">
        <div class="section-label skills__label">
            <span>02</span><span>Skills</span>
        </div>

        <div class="skills__block">
            <h2 class="skills__one">Development</h2>
            <div class="skills__content">
                <ul class="skills__text-one">
                    {skillGroups.development.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <img
                        src={comp.src}
                        alt="Picture of Computer"
                        class="skill-image"
                    />
                    <a href="/portfolioMR/work/?category=Development" class="skill-link">
                        <span>View development work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>

        <div class="skills__block">
            <h2 class="skills__two">Visual design</h2>
            <div class="skills__content">
                <ul class="skills__text-two">
                    {skillGroups.visual.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <img
                        src={palette.src}
                        alt="Picture of Palette"
                        class="skill-image"
                    />
                    <a href="/portfolioMR/work/?category=Visual%20Design" class="skill-link">
                        <span>View visual work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>

        <div class="skills__block">
            <h2 class="skills__three">UX / UI</h2>
            <div class="skills__content">
                <ul class="skills__text-three">
                    {skillGroups.ux.map((item) => <li>{item}</li>)}
                </ul>
                <div class="skill__meta">
                    <img
                        src={lightbulb.src}
                        alt="Picture of Lightbulb"
                        class="skill-image"
                    />
                    <a href="/portfolioMR/work/?category=UX%20Research" class="skill-link">
                        <span>View UX work</span><b>↗</b>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Base>

<style>
    .intro {
        background: var(--color-black);
        border-top: 1px solid var(--color-divider);
        border-bottom: 1px solid var(--color-divider);
        padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    }

    .intro__label {
        margin-bottom: 2rem;
    }

    .intro__grid {
        align-items: end;
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
    }

    .intro__title {
        color: var(--main-color);
        font: 300 clamp(3rem, 8vw, 7rem)/0.9 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .intro__text {
        color: var(--color-muted);
        font: 400 clamp(0.92rem, 1.25vw, 1.2rem)/1.6 var(--font-display);
        margin: 0;
        max-width: 58rem;
    }

    .intro__panel {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-divider);
        display: grid;
        gap: 0.8rem;
        padding: 0.8rem;
        max-width: 18rem;
        justify-self: end;
    }

    .intro__portrait-wrap {
        aspect-ratio: 4 / 5;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-divider);
        overflow: hidden;
        max-height: 22rem;
    }

    .intro__portrait {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .intro__eyebrow {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        margin: 0;
        text-transform: uppercase;
    }

    .intro__statement {
        color: var(--main-color);
        font: 300 clamp(1.2rem, 2vw, 1.8rem)/1.1 var(--font-display);
        letter-spacing: -0.05em;
        margin: 0;
    }

    @media (max-width: 700px) {
        .intro__grid {
            grid-template-columns: 1fr;
        }

        .intro__panel {
            max-width: 24rem;
            order: -1;
            width: 100%;
        }
    }

    .tools {
        background: var(--color-black);
        padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4rem) 0;
    }

    .tools__list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .tool-badge {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-divider);
        color: var(--main-color);
        display: inline-flex;
        font: 0.62rem var(--font-mono);
        letter-spacing: 0.12em;
        padding: 0.55rem 0.75rem;
        text-transform: uppercase;
    }

    .skills {
        background: var(--color-black);
        padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 5vw, 4rem) 4rem;
    }

    .skills__label {
        margin-bottom: 1rem;
    }

    .skills__block + .skills__block {
        margin-top: 1.5rem;
    }

    .skills__one,
    .skills__two,
    .skills__three {
        color: var(--main-color);
        font: 300 clamp(2rem, 5vw, 4rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .skills__content {
        align-items: end;
        border-top: 1px solid var(--color-divider);
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        padding-top: 1rem;
        flex-wrap: wrap;
    }

    .skills__text-one,
    .skills__text-two,
    .skills__text-three {
        color: var(--color-muted);
        flex: 2 1 16rem;
        font: 400 clamp(1rem, 1.2vw, 1.3rem)/1.6 var(--font-display);
        list-style: disc;
        margin: 0;
        padding-left: 1.5rem;
    }

    .skills__text-one li,
    .skills__text-two li,
    .skills__text-three li {
        margin-bottom: 0.35rem;
    }

    .skill__meta {
        display: grid;
        gap: 0.85rem;
        justify-items: end;
        margin-left: auto;
        min-width: 9rem;
    }

    .skill-image {
        filter: grayscale(1);
        height: auto;
        max-width: 10rem;
        object-fit: contain;
        width: 100%;
    }

    .skill-link {
        align-items: center;
        color: var(--main-color);
        display: inline-flex;
        font: 0.62rem var(--font-mono);
        gap: 0.45rem;
        justify-self: end;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .skill-link b {
        display: inline-flex;
        font-size: 0.9rem;
    }

    .skill-link:hover,
    .skill-link:focus-visible {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .skill-link:hover b,
    .skill-link:focus-visible b {
        color: var(--color-accent);
    }

    @media (max-width: 46rem) {
        .intro__grid {
            grid-template-columns: 1fr;
        }

        .intro__panel {
            max-width: 20rem;
        }

        .tools__list {
            gap: 0.5rem;
        }

        .tool-badge {
            font-size: 0.56rem;
            padding: 0.6rem 0.7rem;
        }

        .skills__content {
            align-items: flex-start;
        }

        .skill-image {
            max-width: 6.5rem;
        }
    }
</style>
