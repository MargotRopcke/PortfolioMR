---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

import { getEntry } from "astro:content";

const skills = await getEntry("about", "skills");
---

<Base title="Home Page">
    <section class="intro">
        <p class="intro__text">
            <b>Hi, I’m Margot</b> — a designer, programmer, and UI/UX enthusiast
            who thrives at the intersection of creativity and functionality. <br />
            I’m passionate about turning ideas into intuitive, visually
            compelling digital experiences that people actually enjoy using. I’m
            a fast learner, a reliable teammate, and a professional who gets
            things done — all while keeping a dash of wit and creativity in my
            work. Whether it’s crafting clean, user-friendly interfaces or
            diving into code to bring designs to life, I tackle challenges with
            curiosity and precision. When I’m not designing or programming, you
            might catch me trying out new trends, experimenting with my own
            creative projects, or finding inspiration in the world around me.
        </p>
    </section>

    <section class="skills">
        <h2 class="skills__one">Development Skills</h2>
        <ul class="skills__text-one">
            {skills.data.development.map((item) => (
                <li>{item}</li>
            ))}
        </ul>

        <h2 class="skills__two">Visual Design Skills</h2>
        <ul class="skills__text-two">
            {skills.data.visual.map((item) => (
                <li>{item}</li>
            ))}
        </ul>

        <h2 class="skills__three">UX Design Skills</h2>
        <ul class="skills__text-three">
            {skills.data.ux.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
    </section>
</Base>

<style>
    .intro {
        background-color: var(--color-black);
        border-radius: 25rem;
        padding: var(--sp-l);
        margin: var(--sp-2xl) 1rem;
    }

    .intro__text {
        padding: var(--sp-m);
        color: var(--main-color);
        font-size: var(--fs--3);
        font-family: var(--font-secondary);
    }
</style>
