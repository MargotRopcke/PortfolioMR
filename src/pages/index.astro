---
import Base from "../layouts/Base.astro";
import Work from "../components/Work.astro";
import "../styles/global.css";
---

<Base title="Home Page">
	<section class="header">
		<h1>Hi, I'm Margot</h1>
		<div class="shape__header">
			<img src="" alt="Picture of Margot" width="200" />
			<img src="/profile.jpg" alt="Picture of Margot" width="200" />
			<button
				class="scroll-btn"
				onclick="document.getElementById('samples').scrollIntoView({ behavior: 'smooth' })"
			>
				Take a look at my work
			</button>
			<div class="hero__button-container">
				<a href="#creations" class="hero__button">Explore more</a>
			</div>
			<img
				src="/src/assets/profilepic.png"
				alt="Picture of Margot"
				width="200"
				class="profilepic"
			/>
		</div>
		<div class="shape"></div>
	</section>

	<section class="specialities">
		<h2 class="s1">Visual</h2>
		<h2 class="s2">UX/UI</h2>
		<h2 class="s3">development</h2>
	</section>

	<section id="samples" class="creations">
	<section class="creations" id="creations">
		<Work />
	</section>
</Base>
