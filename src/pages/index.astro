---
import Base from "../layouts/Base.astro";
import Work from "../components/Work.astro";
import "../styles/global.css";
import me from "../assets/profilepic.png";
---

<Base pageTitle=" / Home">
    <section class="hero">
        <div class="hero__meta">
            <span>Portfolio / 2026</span><span>Designer / Developer / UX Researcher</span>
        </div>
        <div class="hero__grid">
            <h1 class="home__title">
                <span class="name-word">
                    <span class="name-letter" style="--i: 0;">M</span><span class="name-letter" style="--i: 1;">a</span><span class="name-letter" style="--i: 2;">r</span><span class="name-letter" style="--i: 3;">g</span><span class="name-letter" style="--i: 4;">o</span><span class="name-letter" style="--i: 5;">t</span>
                </span><br /><em class="name-word"><span class="name-letter" style="--i: 6;">R</span><span class="name-letter" style="--i: 7;">ö</span><span class="name-letter" style="--i: 8;">p</span><span class="name-letter" style="--i: 9;">c</span><span class="name-letter" style="--i: 10;">k</span><span class="name-letter" style="--i: 11;">e</span></em><span></span>
            </h1>
            <div class="hero__aside">
                <img src={me.src} alt="Picture of Margot" class="profilepic" />
                <p class="home__intro">
                    I design clear, expressive digital experiences where visual
                    craft meets thoughtful technology.
                </p>
                <a href="#creations" class="hero__button"
                    ><span>Scroll to explore</span><b>↓</b></a
                >
            </div>
        </div>
        <div class="hero__line">
            <span>Based in Belgium</span>
        </div>
    </section>

    <section id="creations" class="creations"><Work /></section>

    <section class="specialties" aria-labelledby="skills-title">
        <div class="section-label">
            <span id="skills-title">My 3 specialties</span>
        </div>
        <div class="specialties__list">
            <a href="/portfolioMR/about" class="specialty"
                ><span>01</span><strong>Visual<br />design</strong><b>↗</b></a
            >
            <a href="/portfolioMR/about" class="specialty"
                ><span>02</span><strong>UX / UI<br />researcher</strong><b>↗</b></a
            >
            <a href="/portfolioMR/about" class="specialty"
                ><span>03</span><strong>Development</strong><b
                    >↗</b
                ></a
            >
        </div>
    </section>
</Base>

<style>
    .hero {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(1.5rem, 3vw, 2rem) clamp(1.25rem, 4vw, 4rem) clamp(2rem, 6vw, 4rem);
    }

    .hero__meta,
    .hero__line,
    .section-label {
        display: flex;
        justify-content: space-between;
        color: var(--main-color);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .hero__meta {
        border-bottom: 1px solid var(--color-divider);
        padding-bottom: 0.75rem;
    }

    .hero__grid {
        align-items: end;
        display: grid;
        gap: clamp(2rem, 4vw, 4rem);
        grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.7fr);
        padding: clamp(2.1rem, 6.5vw, 5.3rem) 0 clamp(2rem, 5vw, 4rem);
    }

    .home__title {
        color: var(--main-color);
        font: 300 clamp(4.1rem, 13vw, 16rem)/0.78 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0;
        text-transform: uppercase;
        display: inline-block;
        transform-origin: left center;
        animation: nameReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .home__title > em,
    .home__title > span {
        color: var(--main-color);
        font-style: normal;
        display: inline-block;
        animation: nameAccent 1.2s ease both;
    }

    .name-word {
        white-space: nowrap;
    }

    .name-letter {
        display: inline-block;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(var(--i) * 24ms);
        will-change: transform;
    }

    .home__title:hover .name-letter {
        transform: translateY(-0.1em) rotate(-2deg);
    }

    .home__title:hover .name-letter:nth-child(even) {
        transform: translateY(0.06em) rotate(1.5deg);
    }

    .home__title em {
        animation: accentFloat 4.5s ease-in-out infinite alternate;
        margin-top: 0.16em;
    }

    @keyframes nameReveal {
        0% {
            opacity: 0;
            transform: translateY(28px) scale(0.96);
            filter: blur(8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: blur(0);
        }
    }

    @keyframes nameAccent {
        0% {
            opacity: 0;
            transform: translateY(16px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes accentFloat {
        0% {
            transform: translateY(0);
            opacity: 0.92;
        }
        50% {
            transform: translateY(-4px);
            opacity: 1;
        }
        100% {
            transform: translateY(0);
            opacity: 0.92;
        }
    }

    .hero__aside {
        display: grid;
        gap: 1.5rem;
        justify-items: start;
        margin-left: auto;
        max-width: 22rem;
    }

    .profilepic {
        aspect-ratio: 1;
        filter: grayscale(1);
        object-fit: cover;
        width: clamp(13rem, 26vw, 19rem);
    }

    .home__intro {
        color: var(--color-muted);
        font-size: clamp(1rem, 1.4vw, 1.3rem);
        line-height: 1.45;
        margin: 0;
        max-width: 26ch;
    }

    .hero__button {
        align-items: center;
        border-bottom: 1px solid var(--color-divider);
        color: var(--main-color);
        display: flex;
        font: 0.7rem var(--font-mono);
        justify-content: space-between;
        letter-spacing: 0.12em;
        padding: 0.75rem 0;
        text-decoration: none;
        text-transform: uppercase;
        width: 100%;
    }

    .hero__button b {
        background: transparent;
        border: 1px solid var(--main-color);
        border-radius: 50%;
        display: grid;
        font-size: 1.1rem;
        height: 2.2rem;
        place-items: center;
        width: 2.2rem;
    }

    .hero__line {
        border-top: 1px solid var(--color-divider);
        color: var(--color-muted);
        padding-top: 0.75rem;
    }

    .specialties {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    }

    .section-label {
        color: var(--color-muted);
        display: flex;
        justify-content: space-between;
    }

    .specialties__list {
        display: grid;
        gap: 0.9rem;
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
    }

    .specialty {
        align-items: center;
        border-top: 1px solid var(--color-divider);
        color: var(--main-color);
        display: grid;
        gap: 1rem;
        grid-template-columns: 4rem 1fr auto;
        padding: 1.25rem 0;
        text-decoration: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .specialty:last-child {
        border-bottom: 1px solid var(--color-divider);
    }

    .specialty span,
    .specialty b {
        color: var(--color-muted);
        font: 0.68rem var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .specialty strong {
        font: 300 clamp(2rem, 5vw, 3.2rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        text-transform: uppercase;
    }

    .specialty:hover {
        transform: translateX(0.4rem);
    }

    @media (max-width: 46rem) {
        .hero__grid {
            grid-template-columns: 1fr;
        }

        .hero__aside {
            margin-left: 0;
            max-width: 100%;
        }

        .profilepic {
            width: 12rem;
        }

        .hero__meta span:last-child,
        .hero__line span:last-child {
            text-align: right;
        }

        .specialty {
            gap: 0.75rem;
            grid-template-columns: 3rem 1fr auto;
            padding: 1rem 0;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    gsap.from(".home__title", {
        opacity: 0,
        y: 36,
        filter: "blur(8px)",
        duration: 1.1,
        ease: "power3.out",
    });

    gsap.from(".hero__aside > *", {
        opacity: 0,
        y: 26,
        duration: 0.8,
        stagger: 0.12,
        ease: "power2.out",
        delay: 0.15,
    });

    gsap.utils.toArray(".specialty, .works__item").forEach((item, index) => {
        gsap.fromTo(
            item,
            { opacity: 0, y: 28 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: index * 0.08,
                scrollTrigger: {
                    trigger: item,
                    start: "top 85%",
                },
            },
        );
    });
</script>
