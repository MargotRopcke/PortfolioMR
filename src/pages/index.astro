---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

import Photography from "../components/Photography.astro";
---

<Base title="Home Page">
	<section class="header">
		<h1>Hi, I'm Margot</h1>
		<div class="shape__header">
			<img src="/profile.jpg" alt="Picture of Margot" width="200" />
		</div>
		<div class="shape"></div>
	</section>

	<section class="specialities">
		<h2 class="s1">Visual</h2>
		<h2 class="s2">UX/UI</h2>
		<h2 class="s3">development</h2>
	</section>

	<section class="exploration">
		<div class="works-container">
			<div class="works">
				<div class="grid">
					<a href="https://example.com/page1" class="grid-item">
						<img src="image1.jpg" alt="Image 1" />
					</a>
					<a href="https://example.com/page2" class="grid-item">
						<img src="image2.jpg" alt="Image 2" />
					</a>
					<a href="https://example.com/page3" class="grid-item">
						<img src="image3.jpg" alt="Image 3" />
					</a>
					<a href="https://example.com/page4" class="grid-item">
						<img src="image4.jpg" alt="Image 4" />
					</a>
					<a href="https://example.com/page2" class="grid-item">
						<img src="image2.jpg" alt="Image 5" />
					</a>
					<a href="https://example.com/page3" class="grid-item">
						<img src="image3.jpg" alt="Image 6" />
					</a>
					<a href="https://example.com/page4" class="grid-item">
						<img src="image4.jpg" alt="Image 7" />
					</a>
				</div>
			</div>
			<h2 class="title__exploration">Discover my work</h2>
		</div>
	</section>
</Base>
