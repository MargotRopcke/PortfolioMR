---
import Base from "../layouts/Base.astro";
import Work from "../components/Work.astro";
import "../styles/global.css";
import me from "../assets/profilepic.png";
---

<Base pageTitle=" / Home">
    <section class="hero">
        <div class="hero__meta">
            <span>Portfolio / 2025</span><span>Designer + developer</span>
        </div>
        <div class="hero__grid">
            <h1 class="home__title">
                Margot<br /><em>Ropcke</em><span>.</span>
            </h1>
            <div class="hero__aside">
                <img src={me.src} alt="Picture of Margot" class="profilepic" />
                <p class="home__intro">
                    I design clear, expressive digital experiences where visual
                    craft meets thoughtful technology.
                </p>
                <a href="#creations" class="hero__button"
                    ><span>Scroll to explore</span><b>↓</b></a
                >
            </div>
        </div>
        <div class="hero__line">
            <span>Based in Belgium</span><span
                >Available for select projects</span>
        </div>
    </section>

    <section class="specialties" aria-labelledby="skills-title">
        <div class="section-label">
            <span>01</span><span id="skills-title">What I do</span>
        </div>
        <div class="specialties__list">
            <a href="/portfolioMR/about" class="specialty"
                ><span>01</span><strong>Visual<br />design</strong><b>↗</b></a
            >
            <a href="/portfolioMR/about" class="specialty"
                ><span>02</span><strong>UX / UI<br />researcher</strong><b>↗</b></a
            >
            <a href="/portfolioMR/about" class="specialty"
                ><span>03</span><strong>Development</strong><b
                    >↗</b
                ></a
            >
        </div>
    </section>

    <section id="creations" class="creations"><Work /></section>
</Base>

<style>
    .hero {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(1.5rem, 3vw, 2rem) clamp(1.25rem, 4vw, 4rem) clamp(2rem, 6vw, 4rem);
    }

    .hero__meta,
    .hero__line,
    .section-label {
        display: flex;
        justify-content: space-between;
        color: var(--main-color);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .hero__meta {
        border-bottom: 1px solid var(--color-divider);
        padding-bottom: 0.75rem;
    }

    .hero__grid {
        align-items: end;
        display: grid;
        gap: clamp(2rem, 4vw, 4rem);
        grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.7fr);
        padding: clamp(3rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 4rem);
    }

    .home__title {
        color: var(--main-color);
        font: 300 clamp(4.1rem, 13vw, 16rem)/0.78 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0;
        text-transform: uppercase;
    }

    .home__title em,
    .home__title span {
        color: var(--main-color);
        font-style: normal;
    }

    .hero__aside {
        display: grid;
        gap: 1.5rem;
        justify-items: start;
        margin-left: auto;
        max-width: 22rem;
    }

    .profilepic {
        aspect-ratio: 1;
        filter: grayscale(1);
        object-fit: cover;
        width: clamp(8rem, 16vw, 12.5rem);
    }

    .home__intro {
        color: rgba(255, 255, 255, 0.78);
        font-size: clamp(1rem, 1.4vw, 1.3rem);
        line-height: 1.45;
        margin: 0;
        max-width: 26ch;
    }

    .hero__button {
        align-items: center;
        border-bottom: 1px solid var(--color-divider);
        color: var(--main-color);
        display: flex;
        font: 0.7rem var(--font-mono);
        justify-content: space-between;
        letter-spacing: 0.12em;
        padding: 0.75rem 0;
        text-decoration: none;
        text-transform: uppercase;
        width: 100%;
    }

    .hero__button b {
        background: transparent;
        border: 1px solid var(--main-color);
        border-radius: 50%;
        display: grid;
        font-size: 1.1rem;
        height: 2.2rem;
        place-items: center;
        width: 2.2rem;
    }

    .hero__line {
        border-top: 1px solid var(--color-divider);
        color: rgba(255, 255, 255, 0.7);
        padding-top: 0.75rem;
    }

    .specialties {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    }

    .section-label {
        color: var(--color-muted);
        display: flex;
        justify-content: space-between;
    }

    .specialties__list {
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
    }

    .specialty {
        align-items: center;
        border-top: 1px solid var(--color-divider);
        color: var(--main-color);
        display: grid;
        gap: 1rem;
        grid-template-columns: 4rem 1fr auto;
        padding: 1.5rem 0;
        text-decoration: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .specialty:last-child {
        border-bottom: 1px solid var(--color-divider);
    }

    .specialty span,
    .specialty b {
        color: var(--color-muted);
        font: 0.68rem var(--font-mono);
    }

    .specialty strong {
        font: 300 clamp(2.4rem, 6vw, 6rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        text-transform: uppercase;
    }

    .specialty:hover {
        transform: translateX(0.5rem);
    }

    @media (max-width: 46rem) {
        .hero__grid {
            grid-template-columns: 1fr;
        }

        .hero__aside {
            margin-left: 0;
            max-width: 100%;
        }

        .profilepic {
            width: 8rem;
        }

        .hero__meta span:last-child,
        .hero__line span:last-child {
            text-align: right;
        }

        .specialty {
            gap: 0.75rem;
            grid-template-columns: 3rem 1fr auto;
        }
    }
</style>
