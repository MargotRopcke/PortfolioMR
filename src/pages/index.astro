---
import Base from "../layouts/Base.astro";
import Work from "../components/Work.astro";
import "../styles/global.css";
import me from "../assets/profilepic.png";
---

<Base title="Home Page">
	<section class="header">
		<h1 class="home__title">Hi, I'm Margot</h1>
		<div class="shape__header">
			<div class="hero__button-container">
				<a href="#creations" class="hero__button">Explore more</a>
			</div>
			<img
				src={me.src}
				alt="Picture of Margot"
				width="200"
				class="profilepic"
			/>
		</div>
		<div class="shape"></div>
	</section>

	<section class="specialties">
		<h2 class="s1">Visual</h2>
		<h2 class="s2">UX/UI</h2>
		<h2 class="s3">development</h2>
	</section>

	<section id="samples" class="creations">
		<section class="creations" id="creations">
			<Work />
		</section>
	</section>
</Base>

<script>
  const container = document.querySelector('.shape__header');
  const numArrows = 15;
  const arrows = [];

  const mouse = { x: 0, y: 0, active: false };

  container.addEventListener('mouseenter', () => {
    mouse.active = true;
  });

  container.addEventListener('mouseleave', () => {
    mouse.active = false;
  });

  container.addEventListener('mousemove', (e) => {
    mouse.x = e.pageX;
    mouse.y = e.pageY;
  });

  for (let i = 0; i < numArrows; i++) {
    const arrow = document.createElement('div');
    arrow.style.width = '20px';
    arrow.style.height = '20px';
    arrow.style.position = 'absolute';

    const startX = Math.random() * window.innerWidth;
    const startY = Math.random() * window.innerHeight;

    arrow.style.left = `${startX}px`;
    arrow.style.top = `${startY}px`;
    arrow.style.pointerEvents = 'none';
    arrow.style.opacity = '0.6';
    arrow.style.transform = 'translate(-50%, -50%) rotate(45deg)';
    arrow.style.borderTop = '5px solid #95CEFF';
    arrow.style.borderRight = '5px solid #95CEFF';
    arrow.style.zIndex = '-1';

    document.body.appendChild(arrow);

    arrows.push({
      el: arrow,
      x: startX,
      y: startY,
      startX,
      startY,
      speed: 0.1 + Math.random() * 0.1,
      behind: true
    });
  }

  function isInContainer(arrow) {
    const rect = container.getBoundingClientRect();

    const left = rect.left + window.scrollX;
    const right = rect.right + window.scrollX;
    const top = rect.top + window.scrollY;
    const bottom = rect.bottom + window.scrollY;

    return (
      arrow.x >= left &&
      arrow.x <= right &&
      arrow.y >= top &&
      arrow.y <= bottom
    );
  }

  function animate() {
    arrows.forEach((arrow) => {

      if (mouse.active) {
        arrow.el.style.zIndex = '10';
        arrow.behind = false;

        const dx = mouse.x - arrow.x;
        const dy = mouse.y - arrow.y;

        arrow.x += dx * arrow.speed;
        arrow.y += dy * arrow.speed;

        const angle = Math.atan2(dy, dx) * (180 / Math.PI);
        arrow.el.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;

      } else {
        arrow.el.style.zIndex = '-1';
        arrow.behind = true;

        const dx = arrow.startX - arrow.x;
        const dy = arrow.startY - arrow.y;

        arrow.x += dx * arrow.speed;
        arrow.y += dy * arrow.speed;

        arrow.el.style.transform = 'translate(-50%, -50%) rotate(45deg)';
      }

      arrow.el.style.left = `${arrow.x}px`;
      arrow.el.style.top = `${arrow.y}px`;

      if (!arrow.behind && isInContainer(arrow)) {
        arrow.el.style.borderTop = '5px solid #FF6272';
        arrow.el.style.borderRight = '5px solid #FF6272';
      } else {
        arrow.el.style.borderTop = '5px solid #95CEFF';
        arrow.el.style.borderRight = '5px solid #95CEFF';
      }
    });

    requestAnimationFrame(animate);
  }
  animate();
</script>








