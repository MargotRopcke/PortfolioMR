---
import Base from "../layouts/Base.astro";
import Work from "../components/Work.astro";
import "../styles/global.css";
import me from "../assets/profilepic.png";
---

<Base title="Home Page">
	<section class="header">
		<h1 class="home__title">Hi, I'm Margot</h1>
		<div class="shape__header">
			<div class="hero__button-container">
				<a href="#creations" class="hero__button">Explore more</a>
			</div>
			<img
				src={me.src}
				alt="Picture of Margot"
				width="200"
				class="profilepic"
			/>
		</div>
		<div class="shape"></div>
	</section>

	<section class="specialties">
		<h2><a href="/portfolio/about" class="s1">Visual</a></h2>
		<h2><a href="/portfolio/about" class="s2">UX/UI</a></h2>
		<h2><a href="/portfolio/about" class="s3">development</a></h2>
	</section>

	<section id="samples" class="creations">
		<section class="creations" id="creations">
			<Work />
		</section>
	</section>
</Base>

<style>
/* SPECIALTIES */
.specialties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-l, 20px);
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: var(--sp-2xl, 50px) 0;
    padding-top: 3rem;
}

.s1,
.s2,
.s3 {
	text-decoration: none;
    font-size: 2rem;
    color: var(--main-color);
    padding: calc(var(--sp-xs, 5px) * 2) calc(var(--sp-m, 10px) * 2);
    border-radius: var(--br-l, 10px);
    display: inline-block;
    transition: transform 0.3s ease;
}

.s1:hover {
    animation-play-state: paused;
    color: var(--color-pink);
    background-color: var(--main-color);
}

.s2:hover {
    animation-play-state: paused;
    color: var(--color-orange);
    background-color: var(--main-color);
}


.s3:hover {
    animation-play-state: paused;
    color: var(--color-green);
    background-color: var(--main-color);
}

.s1 {
    --rotate: -6deg;
    transform: rotate(var(--rotate));
    font-family: var(--font-secondary, Arial);
    background-color: var(--color-pink, #ff69b4);
    border: 1px solid var(--color-pink, #ff69b4);
    animation: float1 3s ease-in-out infinite;
}

.s2 {
    --rotate: 5deg;
    transform: rotate(var(--rotate));
    font-family: var(--font-tertiary, Arial);
    background-color: var(--color-orange, #ffa500);
    border: 1px solid var(--color-orange, #ffa500);
    animation: float2 3.5s ease-in-out infinite;
}

.s3 {
    --rotate: -4deg;
    transform: rotate(var(--rotate));
    font-family: var(--font-quaternary, Arial);
    letter-spacing: 1.5px;
    background-color: var(--color-green, #32cd32);
    border: 1px solid var(--color-green, #32cd32);
    animation: float3 4s ease-in-out infinite;
}

@keyframes float1 {
    0% {
        transform: translate(0, 0) rotate(var(--rotate));
    }

    25% {
        transform: translate(10px, -10px) rotate(var(--rotate));
    }

    50% {
        transform: translate(-8px, -5px) rotate(var(--rotate));
    }

    75% {
        transform: translate(5px, 8px) rotate(var(--rotate));
    }

    100% {
        transform: translate(0, 0) rotate(var(--rotate));
    }
}

@keyframes float2 {
    0% {
        transform: translate(0, 0) rotate(var(--rotate));
    }

    25% {
        transform: translate(0, -12px) rotate(var(--rotate));
    }

    50% {
        transform: translate(0, -8px) rotate(var(--rotate));
    }

    75% {
        transform: translate(0, 10px) rotate(var(--rotate));
    }

    100% {
        transform: translate(0, 0) rotate(var(--rotate));
    }
}

@keyframes float3 {
    0% {
        transform: translate(0, 0) rotate(var(--rotate));
    }

    25% {
        transform: translate(-10px, 8px) rotate(var(--rotate));
    }

    50% {
        transform: translate(12px, 5px) rotate(var(--rotate));
    }

    75% {
        transform: translate(-5px, -8px) rotate(var(--rotate));
    }

    100% {
        transform: translate(0, 0) rotate(var(--rotate));
    }
}
</style>

<script>
  const container = document.querySelector('.shape__header');
  const numArrows = 15;
  const arrows = [];

  const mouse = { x: 0, y: 0, active: false };

  container.addEventListener('mouseenter', () => {
    mouse.active = true;
  });

  container.addEventListener('mouseleave', () => {
    mouse.active = false;
  });

  container.addEventListener('mousemove', (e) => {
    mouse.x = e.pageX;
    mouse.y = e.pageY;
  });

  for (let i = 0; i < numArrows; i++) {
    const arrow = document.createElement('div');
    arrow.style.width = '20px';
    arrow.style.height = '20px';
    arrow.style.position = 'absolute';
    arrow.style.pointerEvents = 'none';
    arrow.style.opacity = '0.6';
    arrow.style.transform = 'translate(-50%, -50%) rotate(45deg)';
    arrow.style.borderTop = '5px solid #95CEFF';
    arrow.style.borderRight = '5px solid #95CEFF';
    arrow.style.zIndex = '-1';

    const startX = Math.random() * window.innerWidth;
    const startY = Math.random() * window.innerHeight;

    arrow.style.left = `${startX}px`;
    arrow.style.top = `${startY}px`;

    document.body.appendChild(arrow);

    arrows.push({
      el: arrow,
      x: startX,
      y: startY,
      startX,
      startY,
      speed: 0.1 + Math.random() * 0.1,
    });
  }

  function isInContainer(arrow) {
    const rect = container.getBoundingClientRect();
    const left = rect.left + window.scrollX;
    const right = rect.right + window.scrollX;
    const top = rect.top + window.scrollY;
    const bottom = rect.bottom + window.scrollY;

    return arrow.x >= left && arrow.x <= right && arrow.y >= top && arrow.y <= bottom;
  }

  function animate() {
    arrows.forEach((arrow) => {
      if (mouse.active) {
        arrow.el.style.zIndex = '10';

        const dx = mouse.x - arrow.x;
        const dy = mouse.y - arrow.y;

        arrow.x += dx * arrow.speed;
        arrow.y += dy * arrow.speed;

        const angle = Math.atan2(dy, dx) * (180 / Math.PI);
        arrow.el.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;

        // Only turn red if inside the container while hovering
        if (isInContainer(arrow)) {
          arrow.el.style.borderTop = '5px solid #FF6272';
          arrow.el.style.borderRight = '5px solid #FF6272';
        } else {
          arrow.el.style.borderTop = '5px solid #95CEFF';
          arrow.el.style.borderRight = '5px solid #95CEFF';
        }
      } else {
        arrow.el.style.zIndex = '-1';

        const dx = arrow.startX - arrow.x;
        const dy = arrow.startY - arrow.y;

        arrow.x += dx * arrow.speed;
        arrow.y += dy * arrow.speed;

        arrow.el.style.transform = 'translate(-50%, -50%) rotate(45deg)';
        arrow.el.style.borderTop = '5px solid #95CEFF';
        arrow.el.style.borderRight = '5px solid #95CEFF';
      }

      arrow.el.style.left = `${arrow.x}px`;
      arrow.el.style.top = `${arrow.y}px`;
    });

    requestAnimationFrame(animate);
  }

  animate();
</script>









