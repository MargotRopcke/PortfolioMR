---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import WorkCard from "../../components/WorkCard.astro";

const workCollections = await getCollection("work");
---

<Base pageTitle=" / Work">
    <section class="work-page">
        <header class="work-page__header">
            <div class="section-label">
                <span>Work</span><span>{workCollections.length} projects</span>
            </div>
            <h1>All work</h1>
            <p>Explore the full collection of my projects and experiments.</p>
        </header>

        <ul class="work-page__list">
            {
                workCollections.map((work) => (
                    <li class="work-page__item">
                        <WorkCard {work} />
                    </li>
                ))
            }
        </ul>

        <a href="/portfolioMR/" class="back-link">← Back to home</a>
    </section>
</Base>

<style>
    .work-page {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    }

    .work-page__header {
        border-bottom: 1px solid var(--color-divider);
        padding-bottom: 1.25rem;
    }

    .section-label {
        color: var(--color-muted);
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    h1 {
        font: 300 clamp(2.6rem, 7vw, 6rem) / 0.9 var(--font-display);
        letter-spacing: -0.07em;
        margin: 0;
        text-transform: uppercase;
    }

    p {
        color: var(--color-muted);
        margin: 1rem 0 0;
        max-width: 48ch;
    }

    .work-page__list {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        list-style: none;
        margin: 2rem 0 0;
        padding: 0;
    }

    .work-page__item {
        border: 1px solid var(--color-divider);
        overflow: hidden;
    }

    .back-link {
        border: 1px solid var(--color-divider);
        display: inline-flex;
        font: 0.7rem var(--font-mono);
        letter-spacing: 0.12em;
        margin-top: 2rem;
        padding: 0.85rem 1.2rem;
        text-transform: uppercase;
    }

    .back-link:hover {
        border-color: var(--main-color);
    }
</style>
