---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const workCollections = await getCollection("work");
    return workCollections.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<Detail>
    <section class="work">
        <div class="work__card">
            <h1 class="work__title">{work.data.name}</h1>

            <div class="work__image"> 
                <Image
                    src={work.data.image}
                    alt="workpic"
                    width="200"
                    class="work__images"
                />
            </div>
            <a href="/portfolio/#photography" class="more-button">See Work Online</a>
            <div class="work__content">
                <Content />
            </div>
            <a href="/portfolio/#photography" class="back-button">← Go Back</a>
        </div>
    </section>
</Detail>

<style>
.work {
    display: flex;
    justify-content: center;  
    padding: 2rem;
}

.work__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 650px;         
    width: 100%;
    padding: 2rem;
    background: var(--color-black);    
    border-radius: 1rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    gap: 1.5rem;         
}

.work__content {
     color: var(--main-color);
}

   .more-button {
        font-family: var(--font-secondary);
        display: inline-block;
        padding: 0.5rem 1rem;
        margin-bottom: var(--sp-m);
        background-color: var(--main-color);
        color: var(--color-black);
        text-decoration: none;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

     .more-button:hover {
        background-color: var(--color-black);
                color: var(--main-color);
                border: 1px solid var(--main-color);
    }

     .back-button {
        font-family: var(--font-secondary);
        display: inline-block;
        padding: 0.5rem 1rem;
        margin-bottom: var(--sp-m);
        background-color: var(--color-blue);
        color: var(--color-black);
        text-decoration: none;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        background-color: var(--color-red);
        transform: translateX(-4px);
                color: var(--main-color);
    }
</style>