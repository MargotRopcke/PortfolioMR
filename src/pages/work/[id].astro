---
import { render, getCollection } from "astro:content";
import { Image } from "astro:assets";
import Markdown from "../../layouts/Markdown.astro";

export async function getStaticPaths() {
    const workCollections = await getCollection("work");
    return workCollections.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<Markdown>
    <div slot="top">
        <a href="/#work">Work</a>
        <h2><span>{work.data.name}</span></h2>
    </div>
    <Content />
    <div slot="sidebar" class="profile"></div>
</Markdown>
