---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import blinkVideo from "../../assets/2DEV_surnameName_MO1_FOURBYFOUR_render.mp4";
import nmbsVideo from "../../assets/2DEV_Motion1_MargotRopcke_NMBS.mp4";
import modicaVideo from "../../assets/2DEV_RopckeMargot_MO2_Kickstart.mp4";

export async function getStaticPaths() {
    const workCollections = await getCollection("work");
    return workCollections.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const categories = work.data.categories ?? [];
---

<Detail>
    <section class="work">
        <div class="work__card">
            <h1 class="work__title">{work.data.name}</h1>

            <div class="work__meta" aria-label="Project categories">
                {categories.length > 0 ? (
                    categories.map((category) => (
                        <span class="work__tag">{category}</span>
                    ))
                ) : (
                    <span class="work__tag">Project</span>
                )}
            </div>

            <div class="work__content">
                <Content />
            </div>

            {work.id === "work1" || work.id === "work4" || work.id === "work7" ? (
                <video
                    class="work__video"
                    controls
                    playsinline
                    muted
                    preload="metadata"
                    src={
                        work.id === "work1"
                            ? blinkVideo
                            : work.id === "work4"
                                ? nmbsVideo
                                : modicaVideo
                    }
                />
            ) : (
                <div class="work__image"> 
                    <Image
                        src={work.data.image}
                        alt="workpic"
                        width={1600}
                        quality={90}
                        class="work__images"
                    />
                </div>
            )}
            <a href="https://margotropcke.be/integration1/" class="more-button">See Work Online</a>
            <a href="/portfolioMR/#photography" class="back-button">← Go Back</a>
        </div>
    </section>
</Detail>

<style>
.work {
   background: var(--color-black);
   padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 4rem) 4rem;
}

.work__card {
   display: grid;
   gap: 1.5rem;
   margin: 0 auto;
   max-width: 48rem;
   width: 100%;
}

.work__title {
   color: var(--main-color);
   font: 300 clamp(3rem, 8vw, 7rem)/0.9 var(--font-display);
   letter-spacing: -0.08em;
   margin: 0;
   text-transform: uppercase;
}

.work__meta {
   display: flex;
   flex-wrap: wrap;
   gap: 0.55rem;
   margin-top: -0.25rem;
}

.work__tag {
   border: 1px solid var(--color-divider);
   color: var(--color-muted);
   display: inline-flex;
   font: 0.64rem var(--font-mono);
   letter-spacing: 0.12em;
   padding: 0.5rem 0.7rem;
   text-transform: uppercase;
}

.work__image {
   border: 1px solid var(--color-divider);
   max-height: 42rem;
   overflow: hidden;
}

.work__video {
   aspect-ratio: 16 / 9;
   background: #000;
   border: 1px solid var(--color-divider);
   display: block;
   height: auto;
   max-height: 42rem;
   object-fit: contain;
   width: 100%;
}

.work__images {
   display: block;
   height: auto;
   max-height: 42rem;
   object-fit: cover;
   width: 100%;
}

.work__content {
   color: var(--color-muted);
   font-size: clamp(1rem, 1.2vw, 1.2rem);
   line-height: 1.7;
}

.more-button,
.back-button {
   border: 1px solid var(--color-divider);
   color: var(--main-color);
   display: inline-flex;
   font: 0.7rem var(--font-mono);
   letter-spacing: 0.12em;
   padding: 0.9rem 1.2rem;
   text-transform: uppercase;
   width: fit-content;
}

.more-button:hover,
.back-button:hover {
   border-color: var(--main-color);
}

</style>