---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const workCollections = await getCollection("work");
    return workCollections.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<Detail>
    <section class="work">
        <h1 class="work__title">{work.data.name}</h1>
                <div class="work__image">
                                        <a href="/portfolio/#photography" class="back-button">← Go Back</a>   
                     <Image
        src={work.data.image}
        alt="workpic"
        width="200"
        class="work__images"
      />
                </div>
  <a href="/portfolio/#photography" class="back-button">← Go Back</a>   
        <div class="work__content">
            <Content />
        </div>
    </section>
</Detail>

<style>
     .back-button {
        font-family: var(--font-secondary);
        display: inline-block;
        padding: 0.5rem 1rem;
        margin-bottom: var(--sp-m);
        background-color: var(--color-blue);
        color: var(--main-color);
        text-decoration: none;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        background-color: var(--color-green);
        transform: translateX(-4px);
    }
</style>