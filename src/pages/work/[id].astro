---
import Detail from "../../layouts/Detail.astro";

import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const workCollections = await getCollection("work");
    return workCollections.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<Detail>
    <section class="work">
        <div class="work__card">
            <h1 class="work__title">{work.data.name}</h1>

            <div class="work__image"> 
                <Image
                    src={work.data.image}
                    alt="workpic"
                    width="200"
                    class="work__images"
                />
            </div>
            <a href="https://margotropcke.be/integration1/" class="more-button">See Work Online</a>
            <div class="work__content">
                <Content />
            </div>
            <a href="/portfolioMR/#photography" class="back-button">← Go Back</a>
        </div>
    </section>
</Detail>

<style>
.work {
   background: var(--color-black);
   padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 4rem) 4rem;
}

.work__card {
   display: grid;
   gap: 1.5rem;
   margin: 0 auto;
   max-width: 55rem;
   width: 100%;
}

.work__title {
   color: var(--main-color);
   font: 300 clamp(3rem, 8vw, 7rem)/0.9 var(--font-display);
   letter-spacing: -0.08em;
   margin: 0;
   text-transform: uppercase;
}

.work__image {
   border: 1px solid var(--color-divider);
   overflow: hidden;
}

.work__images {
   display: block;
   height: auto;
   width: 100%;
   object-fit: cover;
}

.work__content {
   color: rgba(255, 255, 255, 0.8);
   font-size: clamp(1rem, 1.2vw, 1.2rem);
   line-height: 1.7;
}

.more-button,
.back-button {
   border: 1px solid var(--color-divider);
   color: var(--main-color);
   display: inline-flex;
   font: 0.7rem var(--font-mono);
   letter-spacing: 0.12em;
   padding: 0.9rem 1.2rem;
   text-transform: uppercase;
   width: fit-content;
}

.more-button:hover,
.back-button:hover {
   border-color: var(--main-color);
}

</style>