---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
---

<Base title="Samples Page">
    <main class="coming-soon">
        <div class="coming-soon__card">
            <p class="coming-soon__eyebrow">My samples</p>
            <h1 class="coming-soon__title">Coming soon</h1>
            <p class="coming-soon__text">
                Working on something new...
            </p>
        </div>
    </main>
</Base>

<style>
    .coming-soon {
        align-items: center;
        background: var(--color-black);
        border-top: 1px solid var(--color-divider);
        border-bottom: 1px solid var(--color-divider);
        display: flex;
        justify-content: center;
        min-height: 70vh;
        padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem);
    }

    .coming-soon__card {
        background: rgba(255, 255, 255, 0.02);
        border: 0;
        max-width: 52rem;
        padding: clamp(1.5rem, 4vw, 3rem);
        position: relative;
        text-align: center;
        width: 100%;
    }

    .coming-soon__eyebrow {
        color: var(--color-muted);
        font: 0.7rem var(--font-mono);
        letter-spacing: 0.12em;
        margin: 0 0 1rem;
        position: relative;
        text-transform: uppercase;
        z-index: 1;
    }

    .coming-soon__title {
        color: var(--main-color);
        font: 300 clamp(2.8rem, 7vw, 6.8rem)/0.9 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0;
        position: relative;
        text-align: center;
        text-transform: uppercase;
        z-index: 1;
    }

    .coming-soon__text {
        color: var(--color-muted);
        font: 400 clamp(1rem, 1.5vw, 1.4rem)/1.6 var(--font-display);
        margin: 1rem auto 0;
        max-width: 32rem;
        position: relative;
        text-align: center;
        z-index: 1;
    }
</style>
