---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

import Extras from "../components/Extras.astro";
import Photo from "../components/Photo.astro";
import Quotes from "../components/Quotes.astro";
import "../styles/global.css";
---

<Base title="Samples Page">
    <section class="header">
        <h1 class="samples__title">My Samples</h1>
        <p class="samples__intro">
            Welcome to my personal collection of creativity. Here, I share my
            own work, photography that captures moments and perspectives, and a
            selection of quotes that inspire me. Each piece reflects a part of
            my vision and the ideas that move me. I hope these glimpses into my
            world resonate with you.
        </p>
    </section>

    <div class="samples__content">
        <section class="work__samples card">
            <Extras />
        </section>

        <section class="quotes__samples card">
            <Quotes />
        </section>

        <section id="picsamples" class="pic__samples card">
            <Photo /> 
        </section>
    </div>
</Base>

<style>
.header {
    background: var(--color-black);
    border-bottom: 1px solid var(--color-divider);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 4rem) 2rem;
}

.samples__title {
    color: var(--main-color);
    font: 300 clamp(3.1rem, 8vw, 7.5rem)/0.9 var(--font-display);
    letter-spacing: -0.08em;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
}

.samples__intro {
    color: var(--color-muted);
    font: 400 clamp(1rem, 1.5vw, 1.4rem)/1.6 var(--font-display);
    margin: 0;
    max-width: 52rem;
}

.samples__content {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 4rem) 4rem;
}

.card {
    background: var(--color-black);
    border: 1px solid var(--color-divider);
    color: var(--main-color);
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    padding: 1.25rem;
    text-align: left;
}

.work__samples,
.quotes__samples,
.pic__samples {
    font-family: var(--font-display);
}

</style>
