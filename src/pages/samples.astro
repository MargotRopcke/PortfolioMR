---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

import Extras from "../components/Extras.astro";
import Photo from "../components/Photo.astro";
import Quotes from "../components/Quotes.astro";
import "../styles/global.css";
---

<Base title="Samples Page">
    <section class="header">
        <h1 class="samples__title">My Samples</h1>
        <p class="samples__intro">
            Welcome to my personal collection of creativity. Here, I share my
            own work, photography that captures moments and perspectives, and a
            selection of quotes that inspire me. Each piece reflects a part of
            my vision and the ideas that move me. I hope these glimpses into my
            world resonate with you.
        </p>
    </section>

    <div class="samples__content">
        <section class="work__samples card">
            <Extras />
        </section>

        <section class="quotes__samples card">
            <Quotes />
        </section>

        <section id="picsamples" class="pic__samples card">
            <Photo /> 
        </section>
    </div>
</Base>

<style>
.header {
    text-align: center;
    padding: var(--sp-m);
    margin-bottom: var(--sp-xl);
}

.samples__title {
    font-family: var(--font-primary);
    color: var(--color-blue);
    font-size: clamp(1rem, 5vw + 0.5rem, 4rem);
    text-align: center;
    margin: var(--sp-2xl) 0;
}

.samples__intro {
    padding: var(--sp-m);
    color: var(--color-black);
    font-size: var(--fs--5);
    font-family: var(--font-secondary);
    font-weight: 800;
}

.samples__content {
    display: flex;
    flex-wrap: wrap;       
    gap: 1.5rem;        
    justify-content: center;
}

.card {
    background-color: var(--color-blue); 
    border-radius: 1rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    padding: 1rem;
    flex: 1 1 300px;     
    max-width: 350px;         
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
}

.work__samples {
    font-family: var(--font-secondary);
    color: var(--color-black);
    border: 3px solid var(--main-color);
}

.quotes__samples {
    font-family: var(--font-secondary);
    color: var(--color-black);
     border: 3px solid var(--main-color);
}


.pic__samples {
    font-family: var(--font-secondary);
    color: var(--color-black);
     border: 3px solid var(--main-color);
}
</style>
