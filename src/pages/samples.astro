---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

import Extras from "../components/Extras.astro";
import Photo from "../components/Photo.astro";
import Quotes from "../components/Quotes.astro";
import "../styles/global.css";
---

<Base title="samples Page">
    <section class="header">
        <h1 class="samples__title">My samples</h1>
        <p class="samples__intro">
            Welcome to my personal collection of creativity. Here, I share my
            own work, photography that captures moments and perspectives, and a
            selection of quotes that inspire me. Each piece reflects a part of
            my vision and the ideas that move me. I hope these glimpses into my
            world resonate with you.
        </p>
    </section>
    <section class="work__samples">
        <Extras />
    </section>
    <section class="quotes__samples">
        <Quotes />
    </section>

    <section id="picsamples" class="pic__samples">
        <Photo />
    </section>
</Base>

<style> 
/* SAMPLES */

.samples__title {
          font-family: var(--font-primary);
    color: var(--color-blue);
    font-size: clamp(1rem, 5vw + 0.5rem, 4rem);
    text-align: center;
    margin: var(--sp-2xl) 0;
}

.samples__intro {
    padding: var(--sp-m);
    color: var(--color-black);
        font-size: var(--fs--5);
        font-family: var(--font-secondary);
        font-weight: 800;
}

.work__samples,
.quotes__samples,
.pic__samples {
    font-family: var(--font-secondary);
    color: var(--color-black);
    padding-left: 1rem;
}
</style>
