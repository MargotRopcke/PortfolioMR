---
import { getCollection } from "astro:content";
import QuotesCard from "./QuotesCard.astro";

const quotes = await getCollection("quotes");
---

<section class="container" id="quotes">
    <header class="quotes-header">
        <h2><span>Quotes</span></h2>
        <p>
            These quotes create an environment that encourages innovation,
            creativity, and personal growth.
        </p>
    </header>

    <div class="quotes-rotator" data-total={quotes.length} client:load>
        {
            quotes.map((quote, i) => (
               <li
                    class={`quote__item ${i === 0 ? "active" : ""}`}
                    data-index={i}
                >
                    <QuotesCard {quote} />
                </li>
            ))
        }
    </div>
</section>

<style>
    .quotes-header {
        border-top: 1px solid var(--color-divider);
        display: grid;
        gap: 0.75rem;
        padding-top: 1rem;
    }

    .quotes-header h2 {
        color: var(--main-color);
        font: 300 clamp(2.2rem, 5vw, 4rem)/0.9 var(--font-display);
        letter-spacing: -0.07em;
        margin: 0;
        text-transform: uppercase;
    }

    .quotes-header p {
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.6;
        margin: 0;
    }

    .quote__item {
        color: var(--main-color);
        list-style: none;
        opacity: 0;
        position: absolute;
        transition: opacity 0.6s ease;
    }

    .quote__item.active {
        opacity: 1;
        position: relative;
    }

    .quotes-rotator {
        display: flex;
        flex-direction: column;
        min-height: 12rem;
    }
</style>

<script>
    const rotator = document.querySelector(".quotes-rotator");
    const items = rotator.querySelectorAll(".quote__item");
    let index = 0;
    const total = items.length;

    setInterval(() => {
        items[index].classList.remove("active");
        index = (index + 1) % total;
        items[index].classList.add("active");
    }, 4000);
</script>
