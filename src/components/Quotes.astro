---
import { getCollection } from "astro:content";
import QuotesCard from "./QuotesCard.astro";

const quotes = await getCollection("quotes");
---

<section class="container" id="quotes">
    <header>
        <h2><span>Quotes</span></h2>
        <p>
            These quotes create an environment that encourages innovation,
            creativity, and personal growth.
        </p>
    </header>

    <div class="quotes-rotator" data-total={quotes.length} client:load>
        {
            quotes.map((quote, i) => (
                <li 
                    class={`quote__item ${i === 0 ? "active" : ""}`}
                    data-index={i}
                >
                    <QuotesCard {quote} />
                </li>
            ))
        }
    </div>
</section>

<style>
    .quote__item {
        font-family: var(--font-tertiary);
        color: #59b2ff;
        list-style: none;
        opacity: 0;
        position: absolute;
        transition: opacity 0.6s ease;
    }

    .quote__item.active {
        opacity: 1;
        position: relative;
    }

    .quotes-rotator {
       display: flex;
         flex-direction: column;
        align-items: center;
    }
</style>

<script>
    const rotator = document.querySelector(".quotes-rotator");
    const items = rotator.querySelectorAll(".quote__item");
    let index = 0;
    const total = items.length;

    setInterval(() => {
        items[index].classList.remove("active");
        index = (index + 1) % total;
        items[index].classList.add("active");
    }, 4000); 
</script>
