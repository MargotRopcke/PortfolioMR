---
import { getCollection } from "astro:content";
const workCollections = await getCollection("work");
import { Image } from "astro:assets";

import WorkCard from "./WorkCard.astro";
---

<section class="exploration">
    <div class="works__card">
        <div class="works">
            <ul class="works__list">
                {
                    workCollections.map((work) => (
                        <li class="works__item">
                            <a href={`/portfolio/work/${work.id}/`} class="work__link" />
                            <WorkCard {work} />
                        </li>
                    ))
                }
            </ul>
        </div>
        <div class="title-wrapper">
            <h2 class="title__exploration">Hover and discover my work!</h2>
        </div>
    </div>
</section>

<style>
/* EXPLORATION */
.exploration {
    background-color: var(--color-black);
    padding: var(--sp-l);
}

.works__card {
    display: grid;
    grid-template-columns: 2fr auto; 
    gap: var(--sp-l);
    align-items: stretch; 
}

.works__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    grid-auto-rows: 1fr; 
    gap: var(--sp-m);
    padding: var(--sp-s) 0 var(--sp-xl);
    list-style: none;
}

.works__item {
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%; 
}

.works__item > * {
    flex-grow: 1; 
}

.work-card img {
    width: 100%;
    height: 200px; 
    object-fit: cover;
    border-radius: 1rem;
}

.title-wrapper {
    display: flex;
    align-items: flex-start; 
    justify-content: center;
}

.title__exploration {
    font-size: clamp(1.5rem, 5vw, 3rem);
    font-family: var(--font-primary);
    color: var(--main-color);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
    margin-top: 2rem;
}
</style>
