---
import { getCollection } from "astro:content";
const workCollections = (await getCollection("work")).slice(0, 4);
import { Image } from "astro:assets";

import WorkCard from "./WorkCard.astro";
---

<section class="exploration" aria-labelledby="work-title">
    <div class="works__card">
        <div class="works">
            <div class="section-label">
                <span>01</span><span id="work-title">Selected work</span>
            </div>
            <ul class="works__list">
                {
                    workCollections.map((work) => (
                        <li class="works__item">
                            <a
                                href={`/portfolioMR/work/${work.id}/`}
                                class="work__link"
                                data-work-link
                            />
                            <WorkCard {work} />
                        </li>
                    ))
                }
            </ul>
        </div>
        <div class="works__footer">
            <p class="work-note">
                A selection of recent experiments, interfaces and visual stories.
            </p>
            <a href="/portfolioMR/work/" class="work__button">
                <span>View all my work</span><b>↗</b>
            </a>
        </div>
    </div>
</section>

<script>
  const registerWorkLinks = () => {
      document.querySelectorAll("[data-work-link]").forEach((link) => {
          if (link instanceof HTMLElement && link.dataset.bound === "true") return;
          if (link instanceof HTMLElement) {
              link.dataset.bound = "true";
          }

          link.addEventListener("click", () => {
              try {
                  const currentPath = `${window.location.pathname}${window.location.search}`;
                  sessionStorage.setItem("portfolioReturnPath", currentPath);
              } catch {
                  // Ignore storage access issues.
              }
          });
      });
  };

  registerWorkLinks();
  document.addEventListener("astro:page-load", registerWorkLinks);
</script>

<style>
    .exploration {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    }

    .works__card {
        display: grid;
        grid-template-columns: 1fr;
        align-items: start;
        min-width: 0;
    }

    .works {
        min-width: 0;
        overflow-x: hidden;
    }

    .works__list {
        display: flex;
        gap: 1rem;
        list-style: none;
        margin: 0;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        padding: clamp(2rem, 4vw, 3.5rem) 0 0.5rem;
        scroll-behavior: smooth;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

    .works__item {
        display: flex;
        flex: 0 0 clamp(18rem, 26vw, 30rem);
        flex-direction: column;
        height: 100%;
        min-width: 0;
        overflow: hidden;
    }

    .works__item > * {
        flex-grow: 1;
    }


    .work-note {
        color: var(--color-muted);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0;
        max-width: 30ch;
    }

    .works__footer {
        align-items: end;
        display: flex;
        gap: 1.5rem;
        justify-content: space-between;
        margin-top: 1.25rem;
    }

    .work__button {
        align-items: center;
        background: transparent;
        border: 1px solid var(--color-accent);
        color: var(--color-accent);
        display: inline-flex;
        font: 0.68rem var(--font-mono);
        gap: 0.45rem;
        justify-content: center;
        letter-spacing: 0.12em;
        padding: 0.7rem 1rem;
        text-decoration: none;
        text-transform: uppercase;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
            transform 0.2s ease;
        width: fit-content;
    }

    .work__button b {
        font-size: 0.9rem;
    }

    .work__button:hover,
    .work__button:focus-visible {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #ffffff;
        transform: translateY(-1px);
    }

    @media (max-width: 46rem) {
        .works__footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .work__button {
            width: 100%;
        }

        .works__item {
            flex-basis: min(80vw, 24rem);
        }
    }
</style>
