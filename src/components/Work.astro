---
import { getCollection } from "astro:content";
const workCollections = await getCollection("work");
import { Image } from "astro:assets";

import WorkCard from "./WorkCard.astro";
---

<section class="exploration" aria-labelledby="work-title">
    <div class="works__card">
        <div class="works">
            <div class="section-label">
                <span>02</span><span id="work-title">Selected work</span>
            </div>
            <ul class="works__list">
                {
                    workCollections.map((work) => (
                        <li class="works__item">
                            <a
                                href={`/portfolioMR/work/${work.id}/`}
                                class="work__link"
                            />
                            <WorkCard {work} />
                        </li>
                    ))
                }
            </ul>
        </div>
        <p class="work-note">
            A selection of recent experiments, interfaces and visual stories.
        </p>
    </div>
</section>

<style>
    .exploration {
        background: var(--color-black);
        color: var(--main-color);
        padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    }

    .works__card {
        display: grid;
        grid-template-columns: 1fr;
        align-items: start;
    }

    .works__list {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        list-style: none;
        margin: 0;
        padding: clamp(2rem, 4vw, 3.5rem) 0 0;
    }

    .works__item {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .works__item > * {
        flex-grow: 1;
    }

    .section-label {
        color: var(--color-muted);
        display: flex;
        justify-content: space-between;
    }

    .work-note {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 1.25rem 0 0;
        max-width: 30ch;
    }

    @media (min-width: 64rem) {
        .works__list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
