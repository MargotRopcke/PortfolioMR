---
import { getCollection } from "astro:content";
const workCollections = await getCollection("work");
import { Image } from "astro:assets";

import WorkCard from "./WorkCard.astro";
---

<section class="exploration">
    <div class="works__card">
        <div class="works">
            <ul class="works__list">
                {
                    workCollections.map((work) => (
                        <li class="works__item">
                            <WorkCard {work} />
                        </li>
                    ))
                }
            </ul>
        </div>
        <h2 class="title__exploration">Discover my work</h2>
    </div>
</section>

<style>
/* EXPLORATION */
.exploration {
    background-color: var(--color-black);
    padding: var(--sp-l);
}

.works__card {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--sp-l);
    align-items: start;
}

.works__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--sp-m);
    padding: var(--sp-s) 0 var(--sp-2xl);
}

.works__item {
    text-align: center;
    background-color: var(--main-color);
    border-radius: 25rem;
    padding: var(--sp-s) 0 var(--sp-2xl);
}

.title__exploration {
    font-size: clamp(1.5rem, 5vw, 3rem);
    display: inline-block;
    white-space: nowrap;
    grid-column: 2;
    font-family: var(--font-primary);
    color: var(--main-color);
    writing-mode: vertical-rl;
    text-orientation: mixed;
}
    </style>