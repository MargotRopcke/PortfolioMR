---
import { getCollection } from "astro:content";
const extras = await getCollection("extras");

import ExtrasCard from "./ExtrasCard.astro";
---

<section class="container" id="extras">
    <header>
        <h2><span>Free work</span></h2>
        <p>
            This work was entirely done in my free time, which encourages my own
            innovation, creativity, and personal growth.
        </p>
    </header>
    <div class="extras-list">
        {
            extras.map((extra) => (
                <li class="extra__item">
                    <ExtrasCard {extra} />
                </li>
            ))
        }
    </div>
</section>

<style>
    .extra__item {
         list-style: none;
         color: #b0b0b0;
        margin-bottom: var(--sp-m);
    }
</style>