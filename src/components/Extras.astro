---
import { getCollection } from "astro:content";
const extras = await getCollection("extras");

import ExtrasCard from "./ExtrasCard.astro";
---

<section class="container" id="extras">
    <header>
        <h2><span>Our foundations</span></h2>
        <p>
            These foundations create an environment that encourages innovation,
            creativity, and personal growth.
        </p>
    </header>
    <ul>
        {
            extras.map((extra) => (
                <li>
                    <ExtrasCard {extra} />
                </li>
            ))
        }
    </ul>
</section>
