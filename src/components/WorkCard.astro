---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const workCollections = await getCollection("work");
const { work } = Astro.props;
---

<article>
  <a href={`/portfolioMR/work/${work.id}/`} class="work-link">
    <div class="image-wrapper">
      <Image
        src={work.data.image}
        alt="workpic"
        width="200"
        class="work__images"
      />
      <div class="overlay"><span>View project ↗</span></div>
    </div>
  </a>
</article>

<style>
  .image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    background: var(--color-black);
    overflow: hidden;
  }

  .work__images {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.35s ease, transform 0.35s ease;
  }

  .overlay {
    align-items: flex-end;
    display: flex;
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 42%, rgba(0, 0, 0, 0.76));
    color: var(--main-color);
    font: 0.65rem var(--font-mono);
    justify-content: flex-end;
    letter-spacing: 0.12em;
    padding: 1rem;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .image-wrapper:hover .work__images {
    filter: grayscale(0.25) contrast(1.08);
    transform: scale(1.03);
  }
</style>
