---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const workCollections = await getCollection("work");
const { work } = Astro.props;
---

<article>
  <a href={`/portfolioMR/work/${work.id}/`} class="work-link">
    <div class="image-wrapper">
      <Image
        src={work.data.image}
        alt="workpic"
        width="200"
        class="work__images"
      />
      <div class="overlay"><span>View project ↗</span></div>
    </div>
  </a>
</article>

<style>
  .image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    background: var(--main-color);
    overflow: hidden;
  }

  .work__images {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter 0.35s ease,
      transform 0.35s ease;
  }

  .overlay {
    align-items: flex-end;
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(transparent 45%, rgba(23, 23, 23, 0.8));
    color: var(--main-color);
    font: 0.65rem var(--font-mono);
    justify-content: flex-end;
    padding: 1rem;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .image-wrapper:hover .work__images {
    filter: grayscale(0);
    transform: scale(1.03);
  }
</style>
