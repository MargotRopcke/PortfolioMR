---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const workCollections = await getCollection("work");
const { work } = Astro.props;
---

<article>
  <a href={`/portfolioMR/work/${work.id}/`} class="work-link">
    <div class="image-wrapper">
      <Image
        src={work.data.image}
        alt="workpic"
        width="200"
        class="work__images"
      />
      <div class="overlay">
        <span class="project-label">View project</span>
        <span class="project-title">{work.data.name}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    background: var(--color-black);
    overflow: hidden;
  }

  .work__images {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.35s ease, transform 0.35s ease;
  }

  .overlay {
    align-items: flex-start;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.7), transparent 60%);
    color: var(--main-color);
    display: flex;
    flex-direction: column;
    inset: 0;
    justify-content: flex-end;
    letter-spacing: 0.12em;
    opacity: 0;
    padding: 1rem 1rem 1.1rem;
    pointer-events: none;
    position: absolute;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .project-label {
    color: #fff;
    font: 0.58rem var(--font-mono);
    opacity: 0.8;
  }

  .project-title {
    color: #fff;
    font: 300 clamp(1.1rem, 2vw, 1.8rem) / 1 var(--font-display);
    letter-spacing: -0.06em;
    text-transform: none;
  }

  .image-wrapper:hover .overlay {
    opacity: 1;
  }

  .image-wrapper:hover .work__images {
    filter: grayscale(0.25) contrast(1.08);
    transform: scale(1.03);
  }
</style>
