---
const { photo } = Astro.props;
---

<article class="photo-card">
    <a href={`/portfolioMR/photo/${photo.id}/`}>{photo.data.title}</a>
</article>

<style>
    .photo-card a {
        color: var(--main-color);
        display: block;
        font: 300 clamp(1.3rem, 2vw, 2rem)/1 var(--font-display);
        letter-spacing: -0.05em;
        text-transform: uppercase;
    }
</style>
