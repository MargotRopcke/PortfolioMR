---
import { getCollection } from "astro:content";
const works = await getCollection("works");

import WorkCard from "./WorkCard.astro";
---

<section class="exploration">
    <div class="works-container">
        <div class="works">
            <div class="grid">
                {
                    works.map((work) => (
                        <li>
                            <WorkCard {work} />
                        </li>
                    ))
                }
            </div>
            <h2 class="title__exploration">Discover my work</h2>
        </div>
    </div>
</section>
