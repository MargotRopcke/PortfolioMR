---
import linkedin from "../assets/linkedinlogo.png";
import gmail from "../assets/gmaillogo.png";

import Social from "./Social.astro";
---

<div class="footer__container">
    <footer>
        <div class="footer__label">03 / Contact</div>
        <h2 class="footer__title">Let's make<br /><em>something good.</em></h2>
        <p class="footer__cta">Always ready to help you take the next step.</p>
        <div class="footer__list">
            <Social />
        </div>
    </footer>
</div>

<style>
    /* FOOTER */

    .footer__cta {
        color: rgba(255, 255, 255, 0.78);
        font-family: var(--font-display);
        font-size: clamp(1rem, 1.4vw, 1.4rem);
        line-height: 1.6;
        margin-bottom: var(--sp-xs);
        padding-left: 0;
    }

    .footer__container {
        background: var(--color-black);
        border-top: 1px solid var(--color-divider);
        color: var(--main-color);
        padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6rem);
        width: 100%;
    }

    .footer__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .footer__title {
        color: var(--main-color);
        font: 300 clamp(3.5rem, 10vw, 9rem)/0.85 var(--font-display);
        letter-spacing: -0.08em;
        margin: 3rem 0 1.5rem;
        padding: 0;
        text-transform: uppercase;
    }
    .footer__title em {
        color: var(--color-muted);
        font-style: normal;
    }
    .footer__label {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
</style>
