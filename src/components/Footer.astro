---
import Social from "./Social.astro";
---

<div class="footer__container">
    <footer class="footer">
        <div class="footer__label">03 / Contact</div>

        <div class="footer__header">
            <h2 class="footer__title">Let's<br /><em>connect.</em></h2>

            <div class="footer__meta">
                <div class="footer__rule" aria-hidden="true"></div>
                <div class="footer__list">
                    <Social />
                </div>
            </div>
        </div>

        <p class="footer__cta">Always ready to help you take the next step.</p>
    </footer>
</div>

<style>
    .footer {
        display: grid;
        gap: 1rem;
    }

    .footer__header {
        align-items: end;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(0, 1fr) minmax(12rem, 17rem);
        margin-top: 2rem;
    }

    .footer__meta {
        display: grid;
        gap: 0.75rem;
        justify-self: end;
        width: 100%;
    }

    .footer__rule {
        border-top: 1px solid var(--color-divider);
        display: block;
        min-height: 1px;
        width: 100%;
    }

    .footer__cta {
        color: var(--color-muted);
        font-family: var(--font-display);
        font-size: clamp(1rem, 1.4vw, 1.4rem);
        line-height: 1.6;
        margin: 0;
        max-width: 32rem;
    }

    .footer__container {
        background: var(--color-black);
        border-top: 1px solid var(--color-divider);
        color: var(--main-color);
        padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6rem);
        width: 100%;
    }

    .footer__list {
        display: flex;
        justify-content: flex-end;
    }

    .footer__title {
        color: var(--main-color);
        font: 300 clamp(3.5rem, 10vw, 9rem)/0.85 var(--font-display);
        letter-spacing: -0.08em;
        margin: 0;
        padding: 0;
        text-transform: uppercase;
    }

    .footer__title em {
        color: var(--color-muted);
        font-style: normal;
    }

    .footer__label {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    @media (max-width: 46rem) {
        .footer__header {
            grid-template-columns: 1fr;
        }

        .footer__list {
            justify-content: flex-start;
        }
    }
</style>
