---
import linkedin from "../assets/linkedinlogo.png";
import gmail from "../assets/gmaillogo.png";
---

<div class="footer__container">
    <footer>
        <h2 class="footer__title">Let's connect.</h2>
        <ul class="footer__list">
            <li class="footer__item">
                <a
                    class="footer__link"
                    href="https://share.google/R78IFRyeP7E3xaMvO"
                    ><img src={gmail.src} alt="gmail" /></a
                >
            </li>
            <li class="footer__item">
                <a class="footer__link" href="https://be.linkedin.com/"
                    ><img
                        src={linkedin.src}
                        alt="linkedin"
                    /></a
                >
            </li>
        </ul>
    </footer>
</div>

<style>
/* FOOTER */
.footer__container {
    background-color: var(--main-color);
    color: var(--color-red);
    padding: var(--sp-s) 0;
    width: 100%;
}

.footer__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.footer__title {
    font-family: var(--font-primary);
    margin-bottom: var(--sp-m);
    font-size: clamp(2.5rem, 5vw + 1rem, 8rem);
    text-align: start;
    padding-left: 3rem;
}

.footer__item {
    display: inline-block;
    margin-right: var(--sp-m);
}

.footer__link img {
    width: 10vw;
    height: auto;
    max-width: 4rem;
}
</style>