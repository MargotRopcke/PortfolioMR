---
import linkedin from "../assets/linkedinlogo.png";
import gmail from "../assets/gmaillogo.png";

import Social from "./Social.astro";
---

<div class="footer__container">
    <footer>
        <div class="footer__label">03 / Contact</div>
        <h2 class="footer__title">Let's make<br /><em>something good.</em></h2>
        <p class="footer__cta">Always ready to help you take the next step.</p>
        <div class="footer__list">
            <Social />
        </div>
    </footer>
</div>

<style>
    /* FOOTER */

    .footer__cta {
        font-family: var(--font-secondary);
        font-size: var(--fs-2);
        margin-bottom: var(--sp-xs);
        padding-left: 3rem;
    }

    .footer__container {
        background-color: var(--main-color);
        color: var(--color-black);
        padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6rem);
        width: 100%;
    }

    .footer__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .footer__title {
        font-family: var(--font-primary);
        font-size: clamp(3.5rem, 10vw, 9rem);
        letter-spacing: -0.1em;
        line-height: 0.82;
        margin: 3rem 0 1.5rem;
        padding: 0;
    }
    .footer__title em {
        color: var(--color-accent);
        font-style: normal;
    }
    .footer__label {
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
</style>
