---
import { getCollection } from "astro:content";
const photoCollections = await getCollection("photo");

import PhotoCard from "./PhotoCard.astro";
---

<section class="container" id="photography">
    <header>
        <h2><span>Photography</span></h2>
        <p>
            My photography captures the beauty and complexity of the world
            around us, offering unique perspectives and moments frozen in time.
        </p>
    </header>

        <div class="photos__list">
            {
                photoCollections.map((photo) => (
                    <li class="photo__item">
                        <a href={`/portfolio/photo/${photo.id}/`} class="photo__link" />
                        <PhotoCard {photo} />
                    </li>
                ))
            }
        </div>
</section>

<style>
    .photos__list {
        list-style: none;
    }

    .photo__link {
         text-decoration: none;
    }

    .photo__item {
         text-decoration: none;
      border: 2px solid var(--color-orange);
      border-radius: 1rem;
      margin-bottom: var(--sp-s);
    }

    .photo__item:hover {
         text-decoration: none;
         background-color: var(--color-orange);
      border: 2px solid var(--color-orange);
      border-radius: 1rem;
      margin-bottom: var(--sp-s);
    }
</style>