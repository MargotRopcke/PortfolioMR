---
import { base } from "astro:config/server";
---

<div class="container">
    <nav class="nav">
        <ul class="nav__list">
            <li class="nav__item">
                <a
                    href="/portfolio/"
                    class="nav__link--home">Home</a
                >
            </li>
            <li class="nav__item">
                <a
                    href="/portfolio/about"
                    class="nav__link--about">About me</a
                >
            </li>
            <li class="nav__item">
                <a
                    
        href="/portfolio/samples"
                    class="nav__link--samples">My samples</a
                >
            </li>
        </ul>
    </nav>
    <button class="theme-toggle" aria-label="Toggle Dark Mode" transition:persist></button>
</div>

<style>
/* NAVIGATION */

.nav__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(1.5rem + 3vw);
    list-style: none;
    padding-top: var(--sp-s);
    margin: 0;
         background-color: var(--main-color);
}

.nav__link--home,
.nav__link--about,
.nav__link--samples {
    font-family: var(--font-primary);
    text-decoration: none;
    color: var(--color-black);
    font-weight: bold;
    font-size: calc(1rem + 1vw);
}

.nav__link--home:hover,
.nav__link--about:hover,
.nav__link--samples:hover {
    font-family: var(--font-tertiary);
}
</style>

<script transition:persist>
  const root = document.documentElement;
  let toggleBtn;

  function initTheme() {
    toggleBtn = document.querySelector(".theme-toggle"); // re-query button each time
    if (!toggleBtn) return;

    const savedTheme = localStorage.getItem("theme");
    if (savedTheme === "dark") {
      root.classList.add("dark");
    } else {
      root.classList.remove("dark");
    }
    updateIcon();

    toggleBtn.addEventListener("click", toggleTheme);
  }

  function toggleTheme() {
    root.classList.toggle("dark");
    localStorage.setItem(
      "theme",
      root.classList.contains("dark") ? "dark" : "light"
    );
    updateIcon();
  }

  function updateIcon() {
    if (!toggleBtn) return;
    toggleBtn.textContent = root.classList.contains("dark") ? "light" : "dark";
  }

  initTheme();
  document.addEventListener("astro:after-swap", initTheme);
</script>

