---
import { base } from "astro:config/server";
---

<div class="container">
    <nav class="nav">
        <ul class="nav__list">
            <li class="nav__item">
                <a
                    href="/portfolio/"
                    class="nav__link--home">Home</a
                >
            </li>
            <li class="nav__item">
                <a
                    href="/portfolio/about"
                    class="nav__link--about">About me</a
                >
            </li>
            <li class="nav__item">
                <a
                    
        href="/portfolio/samples"
                    class="nav__link--samples">My samples</a
                >
            </li>
        </ul>
    </nav>
    <button class="theme-toggle" aria-label="Toggle Dark Mode"></button>
</div>

<style>
/* NAVIGATION */
.nav__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(1.5rem + 3vw);
    list-style: none;
    padding-top: var(--sp-s);
    margin: 0;
         background-color: var(--main-color);
}

.nav__link--home,
.nav__link--about,
.nav__link--samples {
    font-family: var(--font-primary);
    text-decoration: none;
    color: var(--color-black);
    font-weight: bold;
    font-size: calc(1rem + 1vw);
}

.nav__link--home:hover,
.nav__link--about:hover,
.nav__link--samples:hover {
    font-family: var(--font-tertiary);
}

.theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 999;
    font-family: var(--font-primary);
    font-size: clamp(1.2rem, 2vw, 2rem);
    background-color: var(--main-color);
    color: var(--color-black);
    border: 2px solid var(--color-black);
    border-radius: var(--br-l);
    padding: var(--sp-xs) var(--sp-m);
    cursor: pointer;
    transition: 0.3s ease;
}

.theme-toggle:hover {
    background-color: var(--color-blue);
    color: var(--main-color);
    transform: rotate(-6deg);
}
</style>

<script>
    const toggleBtn = document.querySelector(".theme-toggle");
    const root = document.documentElement;

    function updateIcon() {
        toggleBtn.textContent = root.classList.contains("dark")
            ? "light"
            : "dark";
    }

    toggleBtn.addEventListener("click", () => {
        root.classList.toggle("dark");
        updateIcon();
    });

    updateIcon();
</script>
