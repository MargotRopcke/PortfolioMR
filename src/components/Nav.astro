<header class="site-header">
    <a href="/portfolioMR/" class="brand" aria-label="Margot Ropcke home"
        >MR<span>.</span></a
    >
    <div class="header-actions">
        <button
            class="theme-toggle"
            aria-label="Toggle dark mode"
            transition:persist><span></span></button
        >
        <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="site-menu"
        >
            <span class="menu-toggle__label">Menu</span><span
                class="menu-toggle__icon"><i></i><i></i></span
            >
        </button>
    </div>
</header>

<div class="menu-overlay" id="site-menu" aria-hidden="true">
    <div class="menu-overlay__top">
        <span>Navigation</span>
        <button type="button" class="menu-close" aria-label="Close menu">Close</button>
    </div>
    <nav class="menu" aria-label="Main navigation">
        <a href="/portfolioMR/" class="menu__link"
            ><span class="menu__index">01</span><span>Home</span><b>↗</b></a
        >
        <a href="/portfolioMR/about" class="menu__link"
            ><span class="menu__index">02</span><span>About me</span><b>↗</b></a
        >
        <a href="/portfolioMR/samples" class="menu__link"
            ><span class="menu__index">03</span><span>My samples</span><b>↗</b
            ></a
        >
    </nav>
    <p class="menu-overlay__footer">Design + development<br />Belgium</p>
</div>

<style>
    .site-header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
        position: relative;
        z-index: 10;
    }
    .brand {
        color: var(--main-color);
        font: 400 1.2rem var(--font-display);
        letter-spacing: -0.05em;
        text-decoration: none;
    }
    .brand span {
        color: var(--color-accent);
    }
    .header-actions {
        align-items: center;
        display: flex;
        gap: 1.25rem;
    }
    .theme-toggle {
        background: transparent;
        border: 1px solid var(--main-color);
        border-radius: 50%;
        height: 1.5rem;
        padding: 0;
        width: 1.5rem;
    }
    .theme-toggle span {
        background: var(--main-color);
        border-radius: 50%;
        display: block;
        height: 0.5rem;
        margin: auto;
        width: 0.5rem;
    }
    .menu-toggle {
        align-items: center;
        background: transparent;
        border: 0;
        color: var(--main-color);
        cursor: pointer;
        display: flex;
        font: 0.68rem var(--font-mono);
        gap: 0.6rem;
        letter-spacing: 0.12em;
        padding: 0.4rem 0;
        text-transform: uppercase;
    }
    .menu-toggle__icon {
        display: grid;
        gap: 0.25rem;
        width: 1.25rem;
    }
    .menu-toggle__icon i {
        background: currentColor;
        display: block;
        height: 1px;
        transition: transform 0.25s ease;
        width: 100%;
    }
    .menu-overlay {
        background: var(--color-black);
        color: var(--main-color);
        display: flex;
        flex-direction: column;
        inset: 0;
        height: 100vh;
        opacity: 0;
        overflow-y: auto;
        padding: clamp(1.25rem, 4vw, 4rem);
        pointer-events: none;
        position: fixed;
        transform: translateY(-100%);
        transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
        width: 100vw;
        z-index: 9999;
    }
    .menu-overlay.is-open {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
        z-index: 9999;
    }
    .menu-overlay__top {
        color: var(--color-muted);
        display: flex;
        font: 0.65rem var(--font-mono);
        justify-content: space-between;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .menu-close {
        background: transparent;
        border: 1px solid var(--color-divider);
        color: var(--main-color);
        cursor: pointer;
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        padding: 0.35rem 0.75rem;
        text-transform: uppercase;
    }
    .menu {
        display: grid;
        margin: auto 0;
    }
    .menu__link {
        align-items: baseline;
        border-bottom: 1px solid var(--color-divider);
        color: var(--main-color);
        display: grid;
        gap: 1rem;
        grid-template-columns: 3rem 1fr auto;
        padding: 0.8rem 0;
        text-decoration: none;
        transform: translateY(1.5rem);
        transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }
    .menu__link:first-child {
        border-top: 1px solid var(--color-divider);
    }
    .menu-overlay.is-open .menu__link {
        animation: menu-link-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .menu-overlay.is-open .menu__link:nth-child(2) {
        animation-delay: 0.08s;
    }
    .menu-overlay.is-open .menu__link:nth-child(3) {
        animation-delay: 0.16s;
    }
    .menu__index,
    .menu__link b {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
    }
    .menu__link > span:nth-child(2) {
        --menu-link-size: clamp(3.3rem, 9vw, 9rem);
        font: 300 var(--menu-link-size)/0.9 var(--font-display);
        letter-spacing: -0.06em;
        text-transform: uppercase;
        transition: color 0.25s ease, letter-spacing 0.25s ease;
    }
    .menu__link:hover {
        color: var(--color-accent);
        transform: translateX(0.7rem);
    }
    .menu__link:hover > span:nth-child(2) {
        letter-spacing: -0.02em;
    }
    .menu-overlay__footer {
        color: var(--color-muted);
        font: 0.65rem var(--font-mono);
        letter-spacing: 0.12em;
        line-height: 1.5;
        text-transform: uppercase;
    }
    @keyframes menu-link-in {
        to {
            transform: translateY(0);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .menu-overlay,
        .menu__link,
        .menu__link > span:nth-child(2) {
            animation: none;
            transition: none;
        }
    }
</style>

<script transition:persist>
    const root = document.documentElement;
    let toggleBtn;
    let menuButton;
    let menuOverlay;

    function syncThemeButton() {
        const isDark = root.classList.contains("dark");
        if (!toggleBtn) return;
        toggleBtn.setAttribute(
            "aria-label",
            isDark ? "Switch to light mode" : "Switch to dark mode",
        );
        toggleBtn.title = isDark ? "Switch to light mode" : "Switch to dark mode";
    }

    function initTheme() {
        toggleBtn = document.querySelector(".theme-toggle");
        if (!toggleBtn) return;
        const savedTheme = localStorage.getItem("theme");
        root.classList.toggle("dark", savedTheme === "dark");
        syncThemeButton();
        toggleBtn.onclick = () => {
            root.classList.toggle("dark");
            const nextTheme = root.classList.contains("dark") ? "dark" : "light";
            localStorage.setItem("theme", nextTheme);
            syncThemeButton();
        };
    }

    function initMenu() {
        menuButton = document.querySelector(".menu-toggle");
        menuOverlay = document.querySelector(".menu-overlay");
        if (!menuButton || !menuOverlay) return;

        const closeMenu = () => {
            menuOverlay.classList.remove("is-open");
            menuOverlay.setAttribute("aria-hidden", "true");
            menuButton.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
        };

        const openMenu = () => {
            menuOverlay.classList.add("is-open");
            menuOverlay.setAttribute("aria-hidden", "false");
            menuButton.setAttribute("aria-expanded", "true");
            document.body.style.overflow = "hidden";
        };

        menuButton.onclick = () => {
            const isOpen = menuOverlay.classList.contains("is-open");
            if (isOpen) {
                closeMenu();
            } else {
                openMenu();
            }
        };

        const closeButton = menuOverlay.querySelector(".menu-close");
        if (closeButton) {
            closeButton.onclick = closeMenu;
        }

        menuOverlay
            .querySelectorAll("a")
            .forEach((link) => link.addEventListener("click", closeMenu));
        document.onkeydown = (event) => {
            if (event.key === "Escape") closeMenu();
        };
    }

    initTheme();
    initMenu();
    document.addEventListener("astro:after-swap", () => {
        initTheme();
        initMenu();
    });
</script>
