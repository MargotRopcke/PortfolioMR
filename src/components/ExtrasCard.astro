---
const { extra } = Astro.props;
---

<details>
    <summary>{extra.data.title}</summary>
</details>

<style>
    details {
        border-top: 1px solid var(--color-divider);
        color: var(--main-color);
        padding-top: 0.75rem;
    }

    summary {
        cursor: pointer;
        font: 300 clamp(1.2rem, 2vw, 1.8rem)/1.2 var(--font-display);
        letter-spacing: -0.04em;
        list-style: none;
        text-transform: uppercase;
    }
</style>
